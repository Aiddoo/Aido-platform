# Aido monorepo — .gitignore
# - 저장소 전체에 공통인 항목만 둔다. 앱 전용 항목은 apps/<app>/.gitignore에 둔다.
# - 비밀값은 올리지 않는다. 환경 변수는 *.example 파일만 올린다.

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.expo/
*.tsbuildinfo

# Tests & coverage
coverage/
.vitest/

# Environment & secrets
.env*
!.env*.example
# E2E 전용 가짜 값만 담겨 있어 올린다
!/apps/api/.env.test
.secrets/

# Signing keys & store binaries
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.ipa
*.apk
*.aab

# Logs
*.log

# Tool caches & local workspaces
.turbo/
.worktrees/
myDocs/

# Claude Code: 팀이 함께 쓰는 명령·설정만 올리고 개인 설정·worktree는 뺀다
/.claude/*
!/.claude/commands/
!/.claude/settings.json
settings.local.json

# Editors & OS
.idea/
.cursor/
.zed/*
!.zed/settings.json
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
