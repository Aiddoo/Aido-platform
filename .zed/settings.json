{
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "formatter": "language_server",
      "language_servers": ["oxlint", "oxfmt", "vtsls", "!typescript-language-server"],
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports": false
      }
    },
    "TSX": {
      "formatter": "language_server",
      "language_servers": ["oxlint", "oxfmt", "vtsls", "!typescript-language-server"],
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports": false
      }
    },
    "JavaScript": {
      "formatter": "language_server",
      "language_servers": ["oxlint", "oxfmt"]
    },
    "JSON": {
      "formatter": "language_server",
      "language_servers": ["oxfmt"]
    }
  }
}
