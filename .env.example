# =============================================================================
# Aido 모노레포 환경변수 (.env)
# 사용법: cp .env.example .env
# Docker 환경: .env.docker.dev.example 또는 .env.docker.prod.example 참고
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aido"

# --- Server ---
NODE_ENV="development"
# 배포 환경 구분 (development | staging | production). 미설정 시 NODE_ENV 기준으로 판단한다.
APP_ENV="development"
# 헬스 체크 응답에 노출할 인스턴스 식별자 (선택). 미설정 시 기동마다 임의 값을 만든다.
# INSTANCE_ID=
PORT=8080

# --- JWT ---
# 액세스 토큰 서명 키 (필수, 32자 이상)
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
# 리프레시 토큰 서명 키 (필수, 32자 이상, JWT_SECRET과 다른 값)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
# 저장 토큰(OAuth 등) 암호화 키 (필수, 32자 이상)
TOKEN_ENCRYPTION_KEY="your-token-encryption-key-change-in-production-min-32-chars"
# 액세스 토큰 만료 시간
JWT_EXPIRES_IN="7d"

# --- Redis ---
# REDIS_URL=redis://localhost:6379
# 명령용 클라이언트 fail-fast 타임아웃 (기본값: 1500 / 5000)
# REDIS_COMMAND_TIMEOUT_MS=1500
# REDIS_CONNECT_TIMEOUT_MS=5000

# --- 신규 가입자 리텐션 V2 (기본 비활성) ---
RETENTION_ONBOARDING_V2_ENABLED=false
RETENTION_ONBOARDING_V2_TREATMENT_PERCENT=50

# --- Push Notifications ---
# 푸시 빈도 제한 저장소 (기본값: postgres)
PUSH_RATE_LIMIT_BACKEND=postgres
# Enhanced Push Security를 활성화한 경우에만 설정
# EXPO_ACCESS_TOKEN=

# --- Durable Jobs ---
JOB_BACKEND=postgres
JOB_REDIS_DRAIN_ENABLED=false

# 모바일(Expo) 환경 변수는 apps/mobile/.env.example을 참고한다.

# --- Monitoring ---
# SENTRY_DSN=""
# EXPO_PUBLIC_SENTRY_DSN=""

# --- Turbo (원격 캐싱) ---
# TURBO_TOKEN=
# TURBO_TEAM=

# --- App Version Check ---
# 스토어에 실제 공개된 버전만 설정하고, 양 플랫폼 값 확인 후 활성화합니다.
APP_VERSION_CHECK_ENABLED=false
APP_VERSION_CHECK_IOS_LATEST_VERSION=1.10.0
APP_VERSION_CHECK_ANDROID_LATEST_VERSION=1.10.0

# --- 콕 찌르기 답장·감사 (1.11.0, 기본 비활성) ---
NUDGE_INTERACTIONS_ENABLED=false

# --- 친구 초대 링크 (1.13.0, 기본 비활성) ---
# 초대 링크·수락·보상 API 활성화 여부. 꺼져 있으면 초대 API는 INVITE_2105를 반환한다 (운영 false, 개발 서버 true)
# 꺼져 있어도 이미 수락한 사람의 활동일·사용 시작과 지급 원장은 남기고 지급만 멈춘다. 다시 켜면 다음 정비 작업이 이어서 지급한다
INVITE_ENABLED=false
# 같은 기기·같은 신원 중복 보상 판단용 HMAC 키 (production에서 활성화 시 필수, 32자 이상). 생성: openssl rand -base64 48
# INVITE_CLAIM_HASH_SECRET=

# --- 새 기능 소개 (1.13.0 친구 초대 캠페인, 기본 비활성) ---
# 켜면 CAMPAIGN_ID·MIN_APP_VERSION·LAUNCHED_AT(ISO 8601)이 필요하다
FEATURE_DISCOVERY_ENABLED=false
FEATURE_DISCOVERY_CAMPAIGN_ID=feature-discovery-2026-11
FEATURE_DISCOVERY_MIN_APP_VERSION=1.13.0
# FEATURE_DISCOVERY_LAUNCHED_AT=2026-11-01T00:00:00.000Z
FEATURE_DISCOVERY_AUTO_OPEN=true
