# =============================================================================
# Aido 모노레포 환경변수 (.env)
# 사용법: cp .env.example .env
# Docker 환경: .env.docker.dev.example 또는 .env.docker.prod.example 참고
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aido"

# --- Server ---
NODE_ENV="development"
API_PORT=3000
API_HOST="0.0.0.0"

# --- JWT ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# --- Redis ---
# REDIS_URL=redis://localhost:6379
# 명령용 클라이언트 fail-fast 타임아웃 (기본값: 1500 / 5000)
# REDIS_COMMAND_TIMEOUT_MS=1500
# REDIS_CONNECT_TIMEOUT_MS=5000

# --- 신규 가입자 리텐션 V2 (기본 비활성) ---
RETENTION_ONBOARDING_V2_ENABLED=false
RETENTION_ONBOARDING_V2_TREATMENT_PERCENT=50

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL="http://localhost:3000"

# --- Monitoring ---
# SENTRY_DSN=""
# EXPO_PUBLIC_SENTRY_DSN=""

# --- Turbo (원격 캐싱) ---
# TURBO_TOKEN=
# TURBO_TEAM=
