import { z } from "zod";

import { datetimeSchema } from "../../../common/datetime.js";
import { entityIdSchema } from "../../../common/entity-id.js";
import { cursorPageSchema } from "../../../common/pagination.js";

export const {{camelCase aggregate}}Schema = z.object({
{{#if isSerial}}
  id: z.number().int().positive().describe("ID (양의 정수)"),
{{else}}
  id: entityIdSchema.describe("ID"),
{{/if}}
  userId: entityIdSchema.describe("사용자 ID"),
  name: z.string().describe("이름"),
  createdAt: datetimeSchema.describe("생성 시각 (ISO 8601 UTC)"),
  updatedAt: datetimeSchema.describe("수정 시각 (ISO 8601 UTC)"),
});

export type {{pascalCase aggregate}} = z.infer<typeof {{camelCase aggregate}}Schema>;

export const {{camelCase aggregate}}DetailResponseSchema = z.object({
  {{camelCase aggregate}}: {{camelCase aggregate}}Schema,
});

export type {{pascalCase aggregate}}DetailResponse = z.infer<typeof {{camelCase aggregate}}DetailResponseSchema>;

export const {{camelCase aggregate}}ListResponseSchema = cursorPageSchema(
  {{camelCase aggregate}}Schema,
{{#if isSerial}}
  z.number().int(),
{{else}}
  entityIdSchema,
{{/if}}
  { items: "목록", pagination: "페이지네이션 정보" },
);

export type {{pascalCase aggregate}}ListResponse = z.infer<typeof {{camelCase aggregate}}ListResponseSchema>;
