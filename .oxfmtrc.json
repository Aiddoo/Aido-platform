{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "sortImports": true,
  "sortPackageJson": true,
  "overrides": [
    {
      "files": [
        "apps/api/**/*.{js,cjs,mjs,ts,tsx,json,jsonc,md}",
        "packages/api/**/*.{js,cjs,mjs,ts,tsx,json,jsonc}"
      ],
      "options": {
        "useTabs": false,
        "singleQuote": false
      }
    },
    {
      // 클래스 순서는 Tailwind가 CSS를 내보내는 순서다. cn·tv는 tailwind-merge가 뒤의 클래스를 남기므로 한 문자열 안에 같은 속성 클래스를 두지 않는다
      "files": ["apps/mobile/**/*.{ts,tsx}"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "./apps/mobile/global.css",
          "functions": ["cn", "tv", "clsx"]
        }
      }
    }
  ],
  "ignorePatterns": [
    "**/*.generated.*",
    "turbo/generators/templates/**",
    "apps/api/test/e2e/__snapshots__/**",
    "apps/api/src/modules/notification/email/infrastructure/templates/**",
    "apps/api/test/e2e/fixtures/released-v1-openapi-contract.ts",
    "apps/mobile/assets/**",
    "apps/mobile/uniwind-types.d.ts",
    "apps/mobile/.agents/**",
    "apps/mobile/.claude/skills/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "apps/api/drizzle/**/snapshot.json",
    "apps/api/test/e2e/fixtures/released-*-openapi-contract.ts"
  ]
}
