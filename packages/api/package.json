{
  "name": "@aido/api",
  "version": "0.0.0",
  "private": true,
  "description": "Shared REST contracts, error codes and pure vocabulary for Aido",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js",
      "default": "./dist/common/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary/index.d.ts",
      "import": "./dist/vocabulary/index.js",
      "default": "./dist/vocabulary/index.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*/index.d.ts",
      "import": "./dist/contracts/*/index.js",
      "default": "./dist/contracts/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --build tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aido/test-config": "workspace:*",
    "@aido/typescript-config": "workspace:*",
    "@aido/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
