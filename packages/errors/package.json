{
  "name": "@aido/errors",
  "version": "1.0.0",
  "private": true,
  "description": "FAANG-style numeric error codes for Aido",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:coverage": "pnpm test:cov",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@aido/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
