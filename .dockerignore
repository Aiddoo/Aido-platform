# Allowlist: turbo prune inputs and workspaces used by @aido/server and @aido/database-migrate
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!patches/
!apps/api/
!packages/api/
!tooling/

# Dependencies
**/node_modules/

# Build outputs
**/dist/
**/*.tsbuildinfo

# Tests & coverage
**/coverage/
**/test/
**/*.spec.ts
**/__snapshots__/
**/.vitest/
apps/api/scripts/ai-eval/
apps/api/vitest.config.ts
packages/api/vitest.config.ts

# Environment & secrets (CI는 깨끗한 checkout으로 빌드하지만 로컬 빌드 문맥에도 들어가지 않게 막는다)
**/.env*
**/.secrets/
**/credentials*.json
**/*service-account*.json
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.keystore
**/*.jks

# Docs & agent guides
**/*.md
**/.claude/
apps/api/docs/

# Tool caches
**/.turbo/
**/.DS_Store
**/*.log
