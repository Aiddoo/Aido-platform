# Dependencies
**/node_modules/
.pnpm-store/

# Build outputs
**/dist/
**/.turbo/
**/build/
**/out/
**/.nest/
**/web-build/
**/.cache/
**/.next/
**/.expo/
**/*.tsbuildinfo

# Mobile app (API 빌드에 불필요)
apps/mobile/

# CI/배포 오케스트레이션 (이미지 빌드에 불필요 — 변경 시 COPY . . 레이어 캐시 무효화 방지)
.github/
scripts/
docker-compose*.yml
docker-compose*.yaml
backups/

# Environment (이미지에 시크릿·예제 파일을 넣지 않는다)
**/.env*

# IDE / 에디터 설정
.idea/
.vscode/
.cursor/
.zed/

# AI tools (.claude/worktrees는 매우 커질 수 있다)
**/.claude/
.serena/
.continue/
.mcp.json

# Git
.git/
.gitignore

# 빌드에 쓰이지 않는 루트 설정·문서
**/*.md
**/docs/
LICENSE
.easignore
.turboignore
.oxfmtrc.json
.oxlintrc.json
commitlint.config.ts
myDocs/
my-docs/

# Tests (이미지에 불필요한 테스트·픽스처·산출물)
**/coverage/
**/*.spec.ts
**/*.e2e-spec.ts
**/test/
**/*.test.ts
**/*.test.tsx
**/*.integration-spec.ts
**/*.snap
**/.jest-cache/
**/.vitest/
**/test-results/
**/playwright-report/
**/junit.xml

# Generated (이미지 안에서 contract:emit / db:generate로 다시 만든다)
**/src/generated/
**/prisma/generated/

# Local artifacts
.worktrees/
.secrets/
**/AGENTS.md
**/CLAUDE.md
**/.DS_Store
**/Thumbs.db
**/*.log
