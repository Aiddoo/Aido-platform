# Allowlist: turbo prune inputs and workspaces used by @aido/server and @aido/database-migrate
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!patches/
!apps/api/
!packages/api/
!tooling/

# Dependencies
**/node_modules/

# Build outputs
**/dist/
**/*.tsbuildinfo

# Tests & coverage
**/coverage/
**/test/
**/*.spec.ts
apps/api/scripts/ai-eval/
apps/api/vitest.config.ts
packages/api/vitest.config.ts

# Environment & secrets
**/.env*

# Docs & agent guides
**/*.md
**/.claude/
apps/api/docs/

# Tool caches
**/.turbo/
**/.DS_Store
**/*.log
