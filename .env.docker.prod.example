# =============================================================================
# Aido Docker 프로덕션 환경 (.env.docker.prod)
# 사용법: cp .env.docker.prod.example .env.docker.prod
# 비밀 생성: openssl rand -base64 48
# =============================================================================

# --- App ---
NODE_ENV=production
# 배포 환경 구분 (development | staging | production). 미설정 시 NODE_ENV 기준으로 판단한다.
APP_ENV=production
# 헬스 체크 응답에 노출할 인스턴스 식별자 (선택)
# INSTANCE_ID=
PORT=8080
# 외부에서 이 API에 닿는 기준 주소. 신고 접수 이메일에 관리자 문서의 처리 링크를 만든다. 미설정 시 경로만 적는다.
API_PUBLIC_URL=https://api.your-domain.com

# --- Database (RDS) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@your-rds-endpoint.rds.amazonaws.com:5432/aido?sslmode=require

# --- Durable jobs (현재 운영: PostgreSQL + pg-boss) ---
JOB_BACKEND=postgres
JOB_SCHEMA=pgboss
JOB_REDIS_DRAIN_ENABLED=false

# Redis/Valkey로 전환할 때만 함께 활성화
# REDIS_URL=redis://your-redis-or-valkey-endpoint:6379

# --- JWT (필수 - 반드시 변경) ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Security (필수 - 반드시 변경) ---
TOKEN_ENCRYPTION_KEY=CHANGE_ME
CORS_ORIGINS=https://your-domain.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=https://your-domain.com/v1/auth/google/web-callback

# --- OAuth: Apple ---
# APPLE_TEAM_ID=
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_CALLBACK_URL=https://your-domain.com/v1/auth/apple/callback

# --- OAuth: Kakao ---
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=https://your-domain.com/v1/auth/kakao/web-callback

# --- OAuth: Naver ---
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_CALLBACK_URL=https://your-domain.com/v1/auth/naver/web-callback

# --- Email (프로덕션 필수) ---
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Aido
SUPPORT_EMAIL=support@your-domain.com

# --- External Services ---
# GOOGLE_GENERATIVE_AI_API_KEY=
# DISCORD_SIGNUP_WEBHOOK_URL=
# DISCORD_PAYMENT_WEBHOOK_URL=

# --- AI 작업 설정 (선택, 미설정 시 기본값) ---
# 작업별 Gemini 모델 ID. 미설정 시 gemini-3.1-flash-lite (교체는 eval 통과 후)
# AI_MODEL_PARSE_TODO=
# AI_MODEL_PARSE_MEMO=
# AI_MODEL_REPORT=
# AI_MODEL_SUGGESTION=
# 작업별 프롬프트 버전 (v1 | v2). 미설정 시 v2, v1은 롤백용이며 v2 안정화 뒤 제거 예정
# AI_PROMPT_VERSION_PARSE_TODO=
# AI_PROMPT_VERSION_PARSE_MEMO=
# AI_PROMPT_VERSION_REPORT=
# AI_PROMPT_VERSION_SUGGESTION=
# 작업별 thinking 수준 (minimal | low | medium). 미설정 시 low
# AI_THINKING_PARSE_TODO=
# AI_THINKING_PARSE_MEMO=
# AI_THINKING_REPORT=
# AI_THINKING_SUGGESTION=

# --- RevenueCat ---
# RevenueCat REST API 비밀 키 (서버 측 호출용으로 예약, 현재 미사용)
# REVENUECAT_SECRET_API_KEY=
# 웹훅 서명 검증 비밀 (구독 웹훅 사용 시)
# REVENUECAT_WEBHOOK_SECRET=

# --- Cache ---
CACHE_TYPE=memory
CACHE_DEFAULT_TTL_MS=60000

# --- Push Notifications ---
PUSH_RATE_LIMIT_BACKEND=postgres
# EXPO_ACCESS_TOKEN=
# 신규 가입자만 등록됩니다. 배포 시 false로 두고 검증 후 활성화하세요.
RETENTION_ONBOARDING_V2_ENABLED=false
RETENTION_ONBOARDING_V2_TREATMENT_PERCENT=50

# --- Monitoring ---
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2
# LOG_LEVEL=info

# --- App Version Check ---
# 스토어에 실제 공개된 버전만 설정하고, 양 플랫폼 값 확인 후 활성화합니다.
APP_VERSION_CHECK_ENABLED=false
APP_VERSION_CHECK_IOS_LATEST_VERSION=1.10.0
APP_VERSION_CHECK_ANDROID_LATEST_VERSION=1.10.0

# --- 콕 찌르기 답장·감사 (1.11.0, 기본 비활성) ---
NUDGE_INTERACTIONS_ENABLED=false

# --- 친구 초대 링크 (1.13.0, 기본 비활성) ---
# 초대 링크·수락·보상 API 활성화 여부. 꺼져 있으면 초대 API는 INVITE_2105를 반환한다
# 꺼져 있어도 이미 수락한 사람의 활동일·사용 시작과 지급 원장은 남기고 지급만 멈춘다. 다시 켜면 다음 정비 작업이 이어서 지급한다
INVITE_ENABLED=false
# 같은 기기·같은 신원 중복 보상 판단용 HMAC 키 (production에서 활성화 시 필수, 32자 이상). 생성: openssl rand -base64 48
# INVITE_CLAIM_HASH_SECRET=

# --- 새 기능 소개 (1.13.0 친구 초대 캠페인, 기본 비활성) ---
# 켜면 CAMPAIGN_ID·MIN_APP_VERSION·LAUNCHED_AT(ISO 8601)이 필요하다
FEATURE_DISCOVERY_ENABLED=false
FEATURE_DISCOVERY_CAMPAIGN_ID=feature-discovery-2026-11
FEATURE_DISCOVERY_MIN_APP_VERSION=1.13.0
# FEATURE_DISCOVERY_LAUNCHED_AT=2026-11-01T00:00:00.000Z
FEATURE_DISCOVERY_AUTO_OPEN=true
