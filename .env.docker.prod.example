# =============================================================================
# Aido Docker 프로덕션 환경 (.env.docker.prod)
# 사용법: cp .env.docker.prod.example .env.docker.prod
# 비밀 생성: openssl rand -base64 48
# =============================================================================

# --- App ---
NODE_ENV=production
PORT=8080

# --- Database ---
# DB_USER, DB_PASSWORD, DB_NAME을 변경하면 DATABASE_URL도 맞춰 수정하세요
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=aido
DB_PORT=5432
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/aido

# --- JWT (필수 - 반드시 변경) ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Security (필수 - 반드시 변경) ---
TOKEN_ENCRYPTION_KEY=CHANGE_ME
CORS_ORIGINS=https://your-domain.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- OAuth (프로덕션에서 최소 1개 필수) ---
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=

# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_CALLBACK_URL=

# APPLE_CLIENT_ID=
# APPLE_SERVICE_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_CALLBACK_URL=

# --- Email (프로덕션 필수) ---
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Aido
SUPPORT_EMAIL=support@your-domain.com

# --- External Services ---
# EXPO_ACCESS_TOKEN=
# GOOGLE_GENERATIVE_AI_API_KEY=
# DISCORD_SIGNUP_WEBHOOK_URL=

# --- Cache ---
# CACHE_TYPE=memory
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- Monitoring ---
# SENTRY_DSN=
# LOG_LEVEL=info
