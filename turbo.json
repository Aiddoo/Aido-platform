{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "patches/**", "tooling/typescript/**"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "!test/**",
        "!**/*.test.*",
        "!**/*.spec.ts",
        "!**/__tests__/**",
        "!**/__snapshots__/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"]
    },
    "lint:deps": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"]
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "env": ["TZ"],
      "passThroughEnv": ["AIDO_TEST_WORKERS"]
    },
    "test:node": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!docs/**"]
    },
    "test:cov": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"],
      "outputs": ["coverage/**"],
      "env": ["TZ"],
      "passThroughEnv": ["AIDO_TEST_WORKERS"]
    },
    "test:integration": {
      "dependsOn": ["^build", "transit"],
      "env": ["TZ", "BROADCAST_RECIPIENT_COUNT"],
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "TOKEN_ENCRYPTION_KEY",
        "NODE_ENV",
        "AIDO_TEST_POSTGRES_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_RYUK_DISABLED",
        "AIDO_TEST_DB_WORKERS"
      ]
    },
    "test:contract": {
      "dependsOn": ["^build", "transit"],
      "env": ["TZ"],
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "TOKEN_ENCRYPTION_KEY",
        "NODE_ENV",
        "AIDO_TEST_POSTGRES_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_RYUK_DISABLED",
        "AIDO_TEST_DB_WORKERS"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["TZ"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EXPIRES_IN",
        "JWT_REFRESH_EXPIRES_IN",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "TOKEN_ENCRYPTION_KEY",
        "NODE_ENV",
        "AIDO_TEST_POSTGRES_URL"
      ]
    },
    "check:unused": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!docs/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "//#format:check": {
      "cache": false
    },
    "//#docs:check": {
      "cache": false
    },
    "//#lint:names": {
      "cache": false
    },
    "//#check:unused": {
      "inputs": [
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/package.json",
        "knip.jsonc",
        "pnpm-workspace.yaml",
        ".github/workflows/**",
        "lefthook.yml",
        "!**/node_modules/**",
        "!**/dist/**"
      ]
    }
  }
}
