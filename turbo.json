{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "package.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    "patches/**",
    ".nvmrc",
    "tooling/typescript/**",
    "tooling/vitest/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "passThroughEnv": ["AIDO_TEST_WORKERS"],
      "env": ["TZ"],
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EXPIRES_IN",
        "JWT_REFRESH_EXPIRES_IN",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "TOKEN_ENCRYPTION_KEY",
        "NODE_ENV",
        "AIDO_TEST_POSTGRES_URL"
      ],
      "env": ["TZ"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "TOKEN_ENCRYPTION_KEY",
        "NODE_ENV",
        "AIDO_TEST_POSTGRES_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_RYUK_DISABLED",
        "AIDO_TEST_DB_WORKERS"
      ],
      "env": ["TZ", "BROADCAST_RECIPIENT_COUNT"]
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "TOKEN_ENCRYPTION_KEY",
        "NODE_ENV",
        "AIDO_TEST_POSTGRES_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_RYUK_DISABLED",
        "AIDO_TEST_DB_WORKERS"
      ],
      "env": ["TZ"]
    },
    "test:node": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test:cov": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["AIDO_TEST_WORKERS"],
      "env": ["TZ"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "outputs": []
    },
    "lint:deps": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
