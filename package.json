{
  "name": "@aido/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm --filter @aido/mobile check:conventions",
    "clean": "turbo run clean && rm -rf node_modules",
    "commit": "cz",
    "db:generate": "pnpm --filter @aido/api db:generate",
    "db:migrate": "pnpm --filter @aido/api db:migrate",
    "dev": "turbo run dev",
    "docker:dev:build": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml build",
    "docker:dev:down": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml logs -f api",
    "docker:dev:migrate": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml run --rm migrate",
    "docker:dev:up": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose down",
    "docker:prod:build": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f api",
    "docker:prod:migrate": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml run --rm migrate",
    "docker:prod:up": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml up -d",
    "docker:up": "docker compose up -d",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "postinstall": "turbo build --filter=./packages/*",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prepare": "simple-git-hooks",
    "test": "turbo run test",
    "test:all": "turbo run test && turbo run test:integration && turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "test:coverage": "pnpm --filter @aido/api test:coverage && pnpm --filter @aido/mobile test:coverage",
    "test:e2e": "turbo run test:e2e --filter=@aido/api",
    "typecheck": "turbo run typecheck",
    "test:integration": "turbo run test:integration --filter=@aido/api",
    "db:plan": "pnpm --filter @aido/api db:plan",
    "db:verify": "pnpm --filter @aido/api db:verify"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "turbo": "2.11.6",
    "vite": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck && pnpm build",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yaml,yml,toml}": "oxfmt --write"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25.0.0"
  },
  "packageManager": "pnpm@10.34.6"
}
