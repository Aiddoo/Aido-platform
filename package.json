{
  "name": "@aido/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm format:check && pnpm lint:names && pnpm --filter @aido/server lint:deps && pnpm --filter @aido/server check:unused && pnpm --filter @aido/server check:conventions && pnpm typecheck && pnpm --filter @aido/mobile check:conventions",
    "clean": "turbo run clean && rm -rf node_modules",
    "commit": "cz",
    "db:check": "pnpm --filter @aido/server db:check",
    "db:generate": "pnpm --filter @aido/server db:generate",
    "db:migrate": "pnpm --filter @aido/server db:migrate",
    "dev": "turbo run dev",
    "docker:dev:build": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml build",
    "docker:dev:down": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml logs -f api",
    "docker:dev:migrate": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml run --rm migrate",
    "docker:dev:up": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose down",
    "docker:prod:build": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f api",
    "docker:prod:migrate": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml run --rm migrate",
    "docker:prod:up": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml up -d",
    "docker:up": "docker compose up -d",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gen:api-slice": "turbo gen api-slice",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:names": "ls-lint",
    "postinstall": "turbo build --filter=./packages/*",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "test:all": "turbo run test && turbo run test:integration && turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e --filter=@aido/server",
    "test:integration": "turbo run test:integration --filter=@aido/server",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version && node scripts/release/sync-versions.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@ls-lint/ls-lint": "catalog:",
    "@turbo/gen": "catalog:",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "lefthook": "2.2.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "vite": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.22.2 <27.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
