{
  "name": "@aido/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint format:check docs:check lint:names check:unused lint:deps typecheck",
    "check:unused": "knip --workspace '!apps/mobile'",
    "clean": "turbo run clean && rm -rf node_modules",
    "commit": "cz",
    "db:check": "pnpm --filter @aido/server db:check",
    "db:generate": "pnpm --filter @aido/server db:generate",
    "db:migrate": "pnpm --filter @aido/database-migrate db:deploy",
    "dev": "turbo run dev",
    "docs:check": "node scripts/docs/docs-check.mjs",
    "docker:down": "docker compose --profile '*' down",
    "docker:up": "docker compose up -d",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gen:api-slice": "turbo gen api-slice",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:names": "ls-lint",
    "postinstall": "turbo run build --filter=./packages/*",
    "prepare": "lefthook install",
    "test": "turbo run test test:node",
    "test:all": "turbo run test test:node test:integration test:contract test:e2e --concurrency=1",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e --filter=@aido/server",
    "test:contract": "turbo run test:contract --filter=@aido/server",
    "test:integration": "turbo run test:integration --filter=@aido/server",
    "typecheck": "turbo run typecheck",
    "test:generator": "node turbo/generators/smoke.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@ls-lint/ls-lint": "catalog:",
    "@turbo/gen": "catalog:",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "knip": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "remark-cli": "catalog:",
    "remark-validate-links": "catalog:",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "vite": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.22.3 <27.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
