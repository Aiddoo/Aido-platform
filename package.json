{
  "name": "@aido/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "commit": "cz",
    "db:generate": "pnpm --filter @aido/api db:generate",
    "db:migrate": "pnpm --filter @aido/api prisma:migrate",
    "db:push": "pnpm --filter @aido/api prisma:push",
    "dev": "turbo run dev",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f api",
    "docker:dev:migrate": "DATABASE_URL=postgresql://postgres:postgres@localhost:${DB_PORT:-5433}/aido pnpm --filter @aido/api db:deploy",
    "docker:dev:studio": "DATABASE_URL=postgresql://postgres:postgres@localhost:${DB_PORT:-5433}/aido pnpm --filter @aido/api db:studio",
    "docker:dev:up": "docker compose --env-file ${AIDO_DEV_ENV_FILE:-.env.docker.dev} -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose down",
    "docker:prod:build": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f api",
    "docker:prod:migrate": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml run --rm migrate",
    "docker:prod:up": "docker compose --env-file .env.docker.prod -f docker-compose.prod.yml up -d",
    "docker:up": "docker compose up -d",
    "format": "biome format --write .",
    "postinstall": "turbo build --filter=./packages/* --filter=./tooling/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "simple-git-hooks",
    "test": "turbo run test",
    "test:all": "turbo run test && turbo run test:integration && turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "test:coverage": "pnpm --filter @aido/api test:coverage && pnpm --filter @aido/mobile test:coverage",
    "test:e2e": "turbo run test:e2e --filter=@aido/api",
    "typecheck": "turbo run typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck && pnpm build",
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true",
    "package.json": "sort-package-json"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "lint-staged": "^17.2.0",
    "simple-git-hooks": "^2.13.1",
    "sort-package-json": "^4.0.0",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@shopify/react-native-skia",
      "@suites/di.nestjs",
      "@suites/doubles.jest"
    ],
    "overrides": {
      "@grpc/grpc-js@^1.14.0": "^1.14.4",
      "@hono/node-server@^1": "^1.19.13",
      "@protobufjs/utf8@^1": "^1.1.1",
      "@tootallnate/once@^2": "^2.0.1",
      "@xmldom/xmldom@^0.8.0": "^0.8.13",
      "brace-expansion@^5": "^5.0.6",
      "fast-uri@^3": "^3.1.2",
      "form-data@^4": "^4.0.6",
      "js-yaml@^3": "^3.15.0",
      "minimatch@^3": "^3.1.4",
      "minimatch@^5": "^5.1.8",
      "minimatch@^8": "^8.0.6",
      "node-forge@^1": "^1.4.0",
      "piscina@^4": "^4.9.3",
      "protobufjs@^7": "^7.6.5",
      "qs": "^6.15.2",
      "shell-quote@^1": "^1.8.4",
      "undici@^7": "^7.28.0",
      "vite": "^7.3.5",
      "ws@^7": "^7.5.11",
      "ws@^8": "^8.21.0",
      "yauzl@^3": "^3.2.1"
    },
    "packageExtensions": {
      "uniwind@*": {
        "dependencies": {
          "metro": "0.83.7",
          "metro-cache": "0.83.7"
        }
      }
    }
  }
}
