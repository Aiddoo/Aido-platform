# 공통 항목(node_modules, dist, .expo, .env*, 서명 키, 바이너리 등)은 루트 .gitignore가 담당한다.
# 여기에는 mobile 앱 전용 항목만 둔다.

# Expo
expo-env.d.ts

# Native Platforms (CNG: prebuild가 생성)
/ios/
/android/
.eas/
.easrc
.kotlin/
*.orig.*

# Metro
.metro-health-check*

# Firebase Configuration
google-services.json
google-services-*.json
GoogleService-Info*.plist

# Store Credentials
credentials/
credentials.json
play-store-service-account.json

# Firebase Admin SDK
*-firebase-adminsdk-*.json

# Maestro 실행 산출물 (.maestro/는 흐름이라 커밋한다. 계정은 루트 .env* 규칙이 막는다)
maestro-output/
# heroui-agents-md
.heroui-docs/
