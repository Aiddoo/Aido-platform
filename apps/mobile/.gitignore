# apps/mobile — .gitignore
# - 공통 항목(node_modules, dist, .expo, .env*, 서명 키, 스토어 바이너리)은 루트 .gitignore가 맡는다.
# - 여기에는 모바일 앱 전용 항목만 둔다.

# Expo & Metro
expo-env.d.ts
.metro-health-check*

# Native projects (CNG: expo prebuild가 만든다)
/ios/
/android/
.kotlin/
*.orig.*

# EAS local config
.eas/
.easrc

# Firebase config
google-services.json
google-services-*.json
GoogleService-Info*.plist
*-firebase-adminsdk-*.json

# Store credentials
credentials/
credentials.json
play-store-service-account.json

# Test outputs (Maestro --test-output-dir 로컬 출력. .maestro/는 흐름이라 커밋하고 계정은 루트 .env* 규칙이 막는다)
maestro-output/

# Tool caches (heroui-agents-md가 내려받는 문서)
.heroui-docs/
