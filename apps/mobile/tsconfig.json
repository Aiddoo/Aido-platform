{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@aido/typescript-config/expo.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./app/*"],
      "@src/*": ["./src/*"],
      "@assets/*": ["./assets/*"]
    },
    "lib": ["ES2023", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "types": ["node", "jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    ".maestro/**/scripts/*.ts"
  ],
  "exclude": ["node_modules"]
}
