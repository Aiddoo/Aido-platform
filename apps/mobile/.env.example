# =============================================================================
# Aido 모바일 env 예시. 개발: cp .env.example .env.development · 운영 로컬 빌드: cp .env.example .env
# Expo는 개발에서도 .env를 읽으므로 .env.development에 없는 키는 운영 값이 들어간다(두 파일의 키를 같게 둔다)
# EAS 빌드는 EAS 환경변수(development · preview · production)를 쓴다. 값은 커밋하지 않는다
# =============================================================================

# --- App ---
# 빌드 환경 (development | preview | production). EAS 빌드는 eas.json 프로필 값을 쓴다
APP_ENV=development
# API 주소 (미설정 시 운영 https://api.aido.kr, 개발 http://localhost:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080
# 실기기 개발 시 개발 PC LAN IP (선택, 미설정 시 Metro에서 자동 감지)
# EXPO_PUBLIC_DEV_MACHINE_IP=
# app.json extra.eas.projectId 대체값 (선택)
# EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Kakao ---
# 카카오 네이티브 앱 키 (공개 키, 카카오톡 초대 공유·링크 열기, 1.13.0). 없으면 OS 공유 시트
# EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# --- Firebase (Base64 인코딩한 네이티브 설정 파일) ---
# Android google-services.json Base64
# GOOGLE_SERVICES_JSON=
# iOS GoogleService-Info.plist Base64
# GOOGLE_SERVICES_INFO_PLIST=

# --- RevenueCat (공개 SDK 키) ---
# 값은 EAS 환경변수(`eas env:list --environment <환경>`)와 같게 두고
# `pnpm check:revenuecat-env`로 환경별 키(접두사·길이만 표시)를 확인한다.
# RevenueCat Test Store 키 (개발·preview)
# REVENUECAT_TEST_API_KEY=
# RevenueCat App Store 키
# REVENUECAT_APPLE_API_KEY=
# RevenueCat Play Store 키
# REVENUECAT_GOOGLE_API_KEY=

# --- Sentry ---
# 앱 Sentry DSN (공개). production 빌드만 전송
# EXPO_PUBLIC_SENTRY_DSN=
# 개발 빌드에서도 전송을 강제할 때만 true (테스트 버튼 검증용)
# EXPO_PUBLIC_SENTRY_DEBUG=
# 소스맵 업로드 토큰 (비밀, 운영 로컬 빌드의 .env에만)
# SENTRY_AUTH_TOKEN=
