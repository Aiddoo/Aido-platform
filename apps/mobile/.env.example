# App (development | preview | production)
APP_ENV=development

# API
EXPO_PUBLIC_API_URL=http://localhost:8080
# EXPO_PUBLIC_DEV_MACHINE_IP=192.168.1.100  # 실제 기기 개발 시 (선택, 미설정 시 자동 감지)

# EAS (app.json 또는 환경변수로 관리)
# EXPO_PUBLIC_EAS_PROJECT_ID=  # app.json extra.eas.projectId의 fallback

# Firebase (Base64 인코딩된 네이티브 설정 파일)
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_INFO_PLIST=

# RevenueCat
REVENUECAT_TEST_API_KEY=
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=

# Sentry
# DSN(런타임, publishable). dev/preview는 기본 전송 안 함(프로덕션만 전송).
EXPO_PUBLIC_SENTRY_DSN=
# dev에서 Sentry 전송을 강제로 켤 때만 true (테스트 버튼 검증용). 평소 미설정.
# EXPO_PUBLIC_SENTRY_DEBUG=true
# 소스맵 업로드용 토큰(빌드 전용, .env.local에만 — 절대 커밋 금지)
# SENTRY_AUTH_TOKEN=
