{
  "name": "@aido/mobile",
  "version": "1.10.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "adb:reverse": "adb reverse tcp:8080 tcp:8080",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android",
    "build:development": "eas build --profile development --platform all",
    "build:development:android": "eas build --profile development --platform android",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:production": "eas build --profile production --platform all",
    "build:production:android": "eas build --profile production --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "check": "pnpm lint && pnpm format:check && pnpm check:conventions",
    "check:conventions": "node scripts/check-mobile-conventions.mjs",
    "check:release-assets": "node scripts/check-growth-release-assets.mjs",
    "clean": "rm -rf dist .expo android ios node_modules/.cache",
    "dev": "expo start",
    "dev:android": "pnpm adb:reverse || true && expo start --android",
    "dev:ios": "expo start --ios",
    "dev:web": "expo start --web",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "ios": "expo run:ios",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "native:prebuild": "expo prebuild --clean",
    "submit:production": "eas submit --profile production --platform all --latest",
    "submit:production:android": "eas submit --profile production --platform android --latest",
    "submit:production:ios": "eas submit --profile production --platform ios --latest",
    "test": "jest",
    "test:conventions": "node --test scripts/check-mobile-conventions.test.mjs",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production",
    "test:cov": "jest --coverage"
  },
