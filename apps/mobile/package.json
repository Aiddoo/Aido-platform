{
  "name": "@aido/mobile",
  "version": "1.15.2",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "adb:reverse": "adb reverse tcp:8080 tcp:8080",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android",
    "build:development": "eas build --profile development --platform all",
    "build:development:android": "eas build --profile development --platform android",
    "build:development:ios": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:production": "eas build --profile production --platform all",
    "build:production:android": "eas build --profile production --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:local:android": "eas build --local --platform android --profile production",
    "build:production:local:ios": "eas build --local --platform ios --profile production",
    "check": "pnpm lint && pnpm format:check && pnpm lint:deps",
    "check:ipa-linkage": "node scripts/check-ipa-expo-linkage.mjs",
    "check:native-icons": "node scripts/check-native-icon-assets.mjs",
    "check:revenuecat-env": "node scripts/check-revenuecat-env.mjs",
    "clean": "rm -rf dist .expo android ios node_modules/.cache",
    "dev": "expo start",
    "dev:android": "pnpm adb:reverse || true && expo start --android",
    "dev:ios": "expo start --ios",
    "e2e": "node .maestro/scripts/run-e2e.ts",
    "e2e:accounts": "node .maestro/scripts/accounts.ts",
    "e2e:feature": "node .maestro/scripts/run-e2e.ts --include-tags",
    "e2e:smoke": "node .maestro/scripts/run-e2e.ts --include-tags smoke",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "ios": "expo run:ios",
    "check:unused": "knip --directory ../.. --workspace apps/mobile --config apps/mobile/knip.jsonc",
    "lint": "oxlint .",
    "lint:deps": "depcruise src app --config .dependency-cruiser.cjs --output-type plugin:$PWD/scripts/feature-graph.cjs",
    "lint:fix": "oxlint . --fix",
    "submit:production": "eas submit --profile production --platform all --latest",
    "submit:production:android": "eas submit --profile production --platform android --latest",
    "submit:production:ios": "eas submit --profile production --platform ios --latest",
    "test": "jest",
    "test:handles": "jest --runInBand --detectOpenHandles",
    "test:changed": "jest --onlyChanged",
    "test:related": "jest --findRelatedTests",
    "test:watch": "jest --watch",
    "test:node": "node --test \"scripts/**/__tests__/*.test.mjs\" \"plugins/**/__tests__/*.test.mjs\" store-metadata/art/render.test.mjs",
    "typecheck": "tsc --noEmit",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production",
    "test:cov": "jest --coverage",
    "generate:tab-icons": "node scripts/generate-tab-icons.mjs",
    "store:check": "node scripts/store-listing.mjs check",
    "store:export": "node scripts/store-listing.mjs export",
    "test:store-listing": "node --test scripts/store-listing.test.mjs",
    "store:art": "node store-metadata/art/render.mjs",
    "store:screens": "node --no-warnings .maestro/store-screenshots/scripts/demo-seed.ts",
    "store:screens:capture": "bash .maestro/store-screenshots/capture.sh",
    "test:store-art": "node --test store-metadata/art/render.test.mjs"
  },
  "dependencies": {
