# cp .maestro/.env.maestro.example .maestro/.env.maestro  (git이 무시한다. 커밋하지 않는다)
# 계정 줄은 pnpm e2e:accounts create가 채운다. 값은 여기에 적지 않는다.
# MAESTRO_ 접두 변수는 Maestro가 shell 환경에서 바로 읽어 비밀번호가 명령줄(-e)에 남지 않는다.

# 개발 빌드만 받는다. 운영 앱(com.aido.mobile)이면 흐름이 시작 전에 멈춘다
MAESTRO_APP_ID=com.aido.mobile.dev
MAESTRO_APP_SCHEME=aido-dev
# 개발 클라이언트가 번들을 받을 Metro 주소. 비우면 연결을 건너뛴다(Release 로컬 빌드)
MAESTRO_METRO_URL=http://localhost:8081
# 흐름이 데이터를 준비·정리할 개발 API. 앱의 EXPO_PUBLIC_API_URL과 같은 서버여야 한다
MAESTRO_API_URL=http://localhost:8080

# 개발 테스트 계정 (pnpm e2e:accounts create)
MAESTRO_MAIN_EMAIL=
MAESTRO_MAIN_PASSWORD=
MAESTRO_MAIN_NAME=
# needs-second-account 흐름(친구 초대·알림함)만 쓴다
MAESTRO_SECOND_EMAIL=
MAESTRO_SECOND_PASSWORD=
MAESTRO_SECOND_NAME=

# 선택: accounts.ts가 쓰는 로컬 DB. 기본값은 Docker 개발 DB다
# DATABASE_URL=postgresql://<user>:<password>@localhost:5433/aido
