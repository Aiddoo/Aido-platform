# .env.screens는 `pnpm --filter mobile store:screens seed <ko|en|all>`가 만들고 고친다. 손으로 쓰지 않는다.
# 이 파일은 그 키 이름만 보여 준다. 값은 모두 가짜이고, 캡처는 capture.sh가 MAESTRO_SHOT_*로 옮겨 쓴다.
# <L>은 KO·EN, 계정 <R>은 PREMIUM·FREE·GRANT·NEWBIE다. 아래는 KO 예시이고 EN도 같은 키를 갖는다.

# 실행일 기준 데모 날짜(YYYY-MM-DD)
SCREENS_TODAY=2026-01-01
SCREENS_YESTERDAY=2025-12-31

# 데모 계정. 비밀번호는 seed가 무작위로 만든다
SCREENS_KO_PREMIUM_EMAIL=premium@example.com
SCREENS_KO_PREMIUM_PASSWORD=
SCREENS_KO_PREMIUM_NAME=
SCREENS_KO_FREE_EMAIL=free@example.com
SCREENS_KO_FREE_PASSWORD=
SCREENS_KO_FREE_NAME=
SCREENS_KO_GRANT_EMAIL=grant@example.com
SCREENS_KO_GRANT_PASSWORD=
SCREENS_KO_GRANT_NAME=
SCREENS_KO_NEWBIE_EMAIL=newbie@example.com
SCREENS_KO_NEWBIE_PASSWORD=
SCREENS_KO_NEWBIE_NAME=
SCREENS_KO_PREMIUM_USER_ID=
SCREENS_KO_STRANGER_NAME=
SCREENS_KO_INVITE_CODE=

# 화면 이동에 쓰는 ID. PREMIUM·FREE 계정마다 있다
SCREENS_KO_PREMIUM_TODO_ID=
SCREENS_KO_PREMIUM_CHECKLIST_TODO_ID=
SCREENS_KO_PREMIUM_RECURRING_TODO_ID=
SCREENS_KO_PREMIUM_RECURRING_DATE=
SCREENS_KO_PREMIUM_MEMO_ID=
SCREENS_KO_PREMIUM_NUDGE_ID=
SCREENS_KO_PREMIUM_FRIEND_ID=

# AI 단계 결과. *_SOURCE는 ai(실제 생성)·fallback-text·fallback-row(대체)다
SCREENS_KO_AI_PARSE_TODO=0/0
SCREENS_KO_WEEKLY_REPORT_ID=
SCREENS_KO_WEEKLY_REPORT_SOURCE=ai
SCREENS_KO_MONTHLY_REPORT_ID=
SCREENS_KO_MONTHLY_REPORT_SOURCE=ai
SCREENS_KO_SUGGESTIONS_SOURCE=ai

# 아래는 이 파일이 아니라 셸 환경 변수로 주는 실행 옵션이다
# SCREENS_IOS_APP=/path/to/Aido.app
# SCREENS_ANDROID_APK=/path/to/aido.apk
# SCREENS_OUT=~/Desktop/Aido-Screens-<앱 버전>
# SCREENS_BUILD=
# SCREENS_STOP_OTHER_EMULATORS=0
# SCREENS_DUO_UNFOLDED=ask
# SCREENS_AI_TIMEOUT_SECONDS=300
