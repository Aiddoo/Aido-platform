{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // 모델의 순수 함수는 같은 파일의 Policy가 묶어 쓰고 테스트·필터 인자로도 export한다
  "ignoreExportsUsedInFile": { "function": true },
  "workspaces": {
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "src/features/**/constants/*.events.ts",
        "plugins/*.js",
        // jest 설정이 문자열 경로로만 가리키는 SDK 대체
        "src/testing/mocks/*",
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,cjs}",
        "plugins/**/*.js",
      ],
      // TanStack Register 모듈 보강 파일이다. 보강과 컴파일 검사용 타입(AppQueryMetaGuard 등)은 import하는 곳 없이 쓰인다
      "ignore": ["src/shared/constants/query-meta.ts"],
      "ignoreDependencies": [
        // 코드는 import하지 않지만 share의 podspec이 RNCKakaoSocial·RNCKakaoUser를 요구해 빠지면 pod install이 실패한다 (docs/build-and-release.md 카카오 절)
        "@react-native-kakao/social",
        "@react-native-kakao/user",
        // expo-router 네이티브 Stack 헤더가 옵션 peer로 읽는다(iOS 26 유리 효과)
        "expo-glass-effect",
        "babel-plugin-react-compiler",
        "babel-jest",
      ],
      // Maestro CLI는 npm 패키지가 아니라 따로 설치한다(.maestro/README.md)
      "ignoreBinaries": ["adb", "eas", "maestro"],
    },
  },
}
