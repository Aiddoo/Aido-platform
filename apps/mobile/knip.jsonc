{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "src/features/**/constants/*.events.ts",
        "plugins/*.js",
        // jest 설정이 문자열 경로로만 가리키는 SDK 대체
        "src/testing/mocks/*",
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,cjs}",
        "plugins/**/*.js",
      ],
      // TanStack Register 모듈 보강 파일이다. 보강과 컴파일 검사용 타입(AppQueryMetaGuard 등)은 import하는 곳 없이 쓰인다
      "ignore": ["src/shared/constants/query-meta.ts"],
      "ignoreDependencies": [
        // expo-router 네이티브 Stack 헤더가 옵션 peer로 읽는다(iOS 26 유리 효과)
        "expo-glass-effect",
        "babel-plugin-react-compiler",
        "babel-jest",
      ],
      // Android SDK adb와 EAS CLI는 npm 의존성이 아니라 따로 설치한다
      "ignoreBinaries": ["adb", "eas"],
    },
  },
}
