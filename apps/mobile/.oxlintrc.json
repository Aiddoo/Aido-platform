{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["import", "typescript", "unicorn", "node", "react", "jest", "promise"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/*.generated.*",
    "assets/**",
    ".agents/**",
    ".claude/skills/**",
    "dist/**",
    "coverage/**",
    "uniwind-types.d.ts"
  ],
  "rules": {
    "eslint/curly": ["error", "all"],
    "eslint/no-void": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-console": "error"
      }
    },
    {
      "files": [
        "src/shared/infra/logger/**",
        "src/shared/infra/error-reporter/console-error-reporter.ts",
        "src/shared/infra/analytics/console-analytics.ts",
        "**/*.test.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "src/testing/**", "jest.setup.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": "allow-with-description",
            "ts-ignore": true,
            "ts-nocheck": true
          }
        ],
        "jest/consistent-test-it": [
          "error",
          {
            "fn": "it",
            "withinDescribe": "it"
          }
        ],
        "jest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expectStatus", "expectSignedIn"]
          }
        ],
        "jest/no-focused-tests": "error",
        "jest/no-disabled-tests": "error",
        "jest/no-identical-title": "error",
        "jest/no-standalone-expect": "error",
        "jest/prefer-to-be": "error",
        "jest/prefer-to-have-length": "error"
      }
    },
    {
      "files": ["index.ts"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
