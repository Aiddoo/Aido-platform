{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["import", "typescript", "unicorn", "node", "react", "jest", "promise"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/*.generated.*",
    "assets/**",
    ".agents/**",
    ".claude/skills/**",
    "dist/**",
    "coverage/**",
    "uniwind-types.d.ts"
  ],
  "rules": {
    "eslint/curly": ["error", "all"],
    "eslint/no-void": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // 루트 AGENTS 공통 규칙(중첩 삼항 금지, `#` 비공개만, 생성자 파라미터 프로퍼티 금지)을 앱에도 건다
    "eslint/no-nested-ternary": "error",
    "aido/no-member-accessibility": "error",
    "typescript/parameter-properties": ["error", { "prefer": "class-property" }]
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-console": "error"
      }
    },
    {
      "files": [
        "src/shared/infra/logger/**",
        "src/shared/infra/error-reporter/console-error-reporter.ts",
        "src/shared/infra/analytics/console-analytics.ts",
        "**/*.test.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "src/testing/**", "jest.setup.ts"],
      "rules": {
        // 테스트도 운영 코드와 같은 타입 안전 규칙이다. 루트의 테스트 완화가 extends로 들어오므로 다시 적는다
        "typescript/no-explicit-any": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": true,
            "ts-ignore": true,
            "ts-nocheck": true
          }
        ],
        "jest/consistent-test-it": [
          "error",
          {
            "fn": "it",
            "withinDescribe": "it"
          }
        ],
        "jest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expectStatus", "expectSignedIn"]
          }
        ],
        "jest/no-focused-tests": "error",
        "jest/no-disabled-tests": "error",
        "jest/no-identical-title": "error",
        "jest/no-standalone-expect": "error",
        "jest/prefer-to-be": "error",
        "jest/prefer-to-have-length": "error"
      }
    },
    {
      "files": ["index.ts"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["src/**", "app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "heroui-native",
                "importNames": [
                  "Avatar",
                  "BottomSheet",
                  "Button",
                  "Checkbox",
                  "Input",
                  "Text",
                  "TextArea"
                ],
                "message": "heroui-native의 같은 이름 대신 @src/shared/ui의 부품을 씁니다. 앱 안에서 같은 이름은 하나의 뜻만 갖습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**", "app/**"],
      "excludeFiles": [
        "**/*.{spec,test}.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
