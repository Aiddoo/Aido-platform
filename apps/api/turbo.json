{
	"$schema": "https://v2-9-4.turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"inputs": [
				"src/**",
				"prisma/**",
				"package.json",
				"tsconfig.json",
				"nest-cli.json"
			]
		},
		"test": {
			"inputs": ["src/**", "test/**", "prisma/**", "jest.config.*"]
		},
		"test:e2e": {
			"cache": false,
			"inputs": ["src/**", "test/**", "prisma/**", "jest.config.*"]
		},
		"test:integration": {
			"cache": false,
			"inputs": ["src/**", "test/**", "prisma/**", "jest.config.*"]
		},
		"typecheck": {
			"inputs": ["src/**", "prisma/**", "tsconfig.json"]
		},
		"lint:arch": {
			"inputs": [
				"src/**",
				"scripts/check-*.mjs",
				"test/architecture/**",
				"test/e2e/__snapshots__/openapi-contract.e2e-spec.ts.snap",
				"test/e2e/fixtures/released-v1-openapi-contract.ts",
				"prisma/**",
				".dependency-cruiser.cjs",
				"package.json",
				"tsconfig.json"
			]
		}
	}
}
