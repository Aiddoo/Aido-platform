{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "!src/**/*.spec.ts",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc"
      ]
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "test/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "vitest.config.ts"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        ".env.example",
        ".env.test",
        "docs/alerts.md",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tooling/*/package.json"
      ]
    },
    "test:integration": {
      "inputs": [
        "src/**",
        "test/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        ".env.test"
      ]
    },
    "test:contract": {
      "inputs": [
        "src/**",
        "test/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        ".env.test"
      ]
    },
    "test:cov": {
      "inputs": [
        "src/**",
        "test/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        ".env.example",
        ".env.test",
        "docs/alerts.md"
      ]
    }
  }
}
