{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts"
      ],
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": [
        "src/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        "test/**"
      ],
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "inputs": [
        "src/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        "test/**"
      ],
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false,
      "inputs": [
        "src/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        "test/**"
      ],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        "test/**"
      ],
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "drizzle/**",
        "package.json",
        "drizzle.config.ts",
        "tsconfig*.json",
        "nest-cli.json",
        ".swcrc",
        "vitest.config.ts",
        "test/**"
      ]
    }
  }
}
