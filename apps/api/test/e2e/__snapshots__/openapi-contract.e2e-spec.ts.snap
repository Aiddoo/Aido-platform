          "description": "요청이 성공적으로 처리되었습니다",
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponseSchema",
              },
            },
          },
          "description": "잘못된 요청입니다",
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "error": {
                    "properties": {
                      "code": {
                        "example": "AUTH_0107",
