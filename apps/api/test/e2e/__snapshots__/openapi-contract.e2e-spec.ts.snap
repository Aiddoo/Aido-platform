                    "nullable": true,
                    "type": "object",
                  },
                  "message": {
                    "example": "소셜 로그인 계정은 비밀번호를 변경할 수 없습니다.",
                    "type": "string",
                  },
                },
                "required": [
                  "code",
                  "message",
                ],
                "type": "object",
              },
              "success": {
                "example": false,
                "type": "boolean",
              },
              "timestamp": {
                "example": 1700000000000,
                "type": "number",
              },
            },
            "required": [
              "success",
              "error",
              "timestamp",
            ],
            "type": "object",
          },
        },
        "401": {
          "content": {
