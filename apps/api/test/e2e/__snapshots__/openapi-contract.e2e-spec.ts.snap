    "ResetPasswordDto": {
      "description": "비밀번호 재설정 요청",
      "properties": {
        "code": {
          "description": "이메일로 발송된 6자리 인증 코드",
          "maxLength": 6,
          "minLength": 6,
          "type": "string",
        },
        "email": {
          "description": "비밀번호를 재설정할 계정의 이메일 주소",
          "type": "string",
        },
        "newPassword": {
          "description": "새 비밀번호 (8자 이상, 영문자 1개 이상, 숫자 1개 이상 포함 필수)",
          "maxLength": 72,
          "minLength": 8,
          "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d@$!%*#?&]{8,}$",
          "type": "string",
        },
        "newPasswordConfirm": {
          "description": "새 비밀번호 확인 (newPassword와 동일해야 함)",
          "type": "string",
        },
      },
      "required": [
        "email",
        "code",
        "newPassword",
        "newPasswordConfirm",
      ],
      "type": "object",
    },
