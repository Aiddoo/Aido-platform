                        "type": "object",
                      },
                      "message": {
                        "example": "인증이 필요합니다.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "code",
                      "message",
                    ],
                    "type": "object",
                  },
                  "success": {
                    "example": false,
