          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponseSchema",
              },
            },
          },
          "description": "잘못된 요청입니다",
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "error": {
                    "properties": {
                      "code": {
                        "example": "AUTH_0107",
                        "type": "string",
                      },
                      "details": {
                        "example": null,
