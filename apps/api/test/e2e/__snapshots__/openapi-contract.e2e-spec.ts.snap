          "required": false,
          "schema": {},
        },
        {
          "description": "OAuth 모드 (login: 로그인, link: 계정 연동). 기본값은 login",
          "in": "query",
          "name": "mode",
          "required": false,
          "schema": {
            "enum": [
              "login",
              "link",
            ],
            "type": "string",
          },
        },
        {
          "description": "인증 완료 후 리다이렉트될 URI (기본: aido://auth/callback)",
          "in": "query",
          "name": "redirect_uri",
          "required": false,
          "schema": {
            "example": "aido://auth/callback",
          },
        },
        {
          "description": "CSRF 방지용 상태 값",
          "in": "query",
          "name": "state",
          "required": true,
          "schema": {
            "example": "a1b2c3d4e5f6",
          },
        },
      ],
      "responses": {
