                  "timestamp",
                ],
                "type": "object",
              },
            },
          },
          "description": "요청이 성공적으로 처리되었습니다",
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponseSchema",
              },
            },
          },
          "description": "리마인더 시간 범위가 올바르지 않습니다.

잘못된 요청입니다",
