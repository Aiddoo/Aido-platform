                    },
                    "required": [
                      "code",
                      "message",
                    ],
                    "type": "object",
                  },
                  "success": {
                    "example": false,
                    "type": "boolean",
                  },
                  "timestamp": {
                    "example": 1700000000000,
                    "type": "number",
                  },
                },
                "required": [
