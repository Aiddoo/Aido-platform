# =============================================================================
# Aido API env 예시. 개발: cp .env.example .env.development · 운영: cp .env.example .env
# 서버는 NODE_ENV로 고른다(production → .env, test → .env.test, 그 밖 → .env.development).
# 도커도 같은 파일을 읽는다(docker-compose.yml → .env.development, docker-compose.prod.yml → .env).
# 값은 개발 기준이다. 운영에서 바꿀 값은 각 줄 주석의 "운영"을 따른다. 비밀 생성: openssl rand -base64 48
# =============================================================================

# --- App ---
# 런타임 모드. 운영 production, 개발 development
NODE_ENV=development
# 배포 환경 (development | staging | production). 운영 production. 개발 도구·공급자 기본값·운영 시작 검증의 기준(docs/configuration.md)
APP_ENV=development
# 컨테이너 내부 포트. 운영 compose는 8080으로 고정한다
PORT=8080
# 헬스 체크에 보이는 인스턴스 식별자 (선택, 미설정 시 기동마다 임의 값)
# INSTANCE_ID=
# 로그 레벨 (silent | fatal | error | warn | info | debug | trace, 선택)
# LOG_LEVEL=
# 외부에서 이 API에 닿는 기준 주소 (선택, 운영 https 도메인). 신고 접수 이메일의 관리자 처리 링크에 쓰고, 미설정 시 경로만 적는다
# API_PUBLIC_URL=http://localhost:8080

# --- Database ---
# PostgreSQL 연결 문자열. 개발은 pnpm docker:up 컨테이너(5433), 운영은 RDS 주소에 ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aido
# 연결 풀 최대 연결 수 (기본 10). 유휴 제한(ms)은 비우면 pg 기본값(10초), 연결 대기는 기본 5초
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# sslmode가 있으면 서버 인증서를 검증한다(RDS CA는 이미지의 NODE_EXTRA_CA_CERTS). 비상시에만 true
# DATABASE_SSL_ALLOW_UNVERIFIED=false

# --- Durable jobs (pg-boss) ---
# pg-boss 스키마 이름
JOB_SCHEMA=pgboss
# false면 작업을 넣기만 하고 worker·정기 작업을 돌리지 않는다 (API 전용 프로세스, 선택, 기본 true)
# JOB_WORKER_ENABLED=true
# pg-boss 전용 연결 수 (선택, 기본 3)
# JOB_POOL_MAX=3

# --- Redis · Cache ---
# Redis/Valkey 주소 (redis:// 또는 rediss://). 큐는 pg-boss라 필요 없고, 여러 대를 CACHE_TYPE=redis로 운영할 때만 둔다
# 로컬에서 시험할 때는 docker compose --profile redis up -d로 띄우고 redis://localhost:6379를 쓴다
# REDIS_URL=
# Redis 명령 타임아웃 ms (선택, 기본 1500)
# REDIS_COMMAND_TIMEOUT_MS=
# Redis 연결 타임아웃 ms (선택, 기본 5000)
# REDIS_CONNECT_TIMEOUT_MS=
# 캐시 저장소 (memory | redis). 운영과 같이 memory
CACHE_TYPE=memory
# 메모리 캐시 항목 한도(FIFO). 날씨 칸 캐시가 밀려나면 WeatherKit 호출이 늘어나므로 운영은 3000을 쓴다.
CACHE_MAX_ITEMS=3000
# 캐시 기본 TTL ms
CACHE_DEFAULT_TTL_MS=60000

# --- Auth · 암호화 ---
# 액세스 토큰 서명 키 (32자 이상). 운영은 새로 만든 비밀
JWT_SECRET=dev-jwt-secret-key-minimum-32-characters-long-for-security
# 리프레시 토큰 서명 키 (32자 이상, JWT_SECRET과 다른 값). 운영은 새로 만든 비밀
JWT_REFRESH_SECRET=dev-refresh-secret-key-minimum-32-characters-long-here
# 액세스 토큰 만료
JWT_EXPIRES_IN=15m
# 리프레시 토큰 만료
JWT_REFRESH_EXPIRES_IN=7d
# 저장 토큰 암호화 키 (32자 이상). 운영은 새로 만든 비밀이고, 바꾸면 기존 암호문을 못 읽는다
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-minimum-32-characters-long
# 암호화 salt (선택, 8자 이상). 운영은 미설정(기본 salt) — 바꾸면 기존 암호문을 못 읽는다
# TOKEN_ENCRYPTION_SALT=
# 댓글 커서·광고 수신 거부 토큰 서명 키 (선택). "kid:secret,kid2:secret2", 첫 항목이 서명 키, secret 32자 이상.
# 비우면 JWT_SECRET으로 서명한다. 키를 넣어도 JWT_SECRET으로 서명한 기존 토큰은 계속 검증한다
# CURSOR_SIGNING_KEYS=
# OPT_OUT_TOKEN_SIGNING_KEYS=

# --- Security ---
# 허용 Origin (쉼표 구분). 개발은 localhost·Expo, 운영은 실제 https 도메인
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081
# 요청 제한 창 ms
THROTTLE_TTL=60000
# 창당 최대 요청 수. 운영 100, 개발 1000
THROTTLE_LIMIT=1000

# --- OAuth (운영은 provider 하나 이상 필수) ---
# Google OAuth 클라이언트 ID (모바일 id 토큰 audience 겸용)
# GOOGLE_CLIENT_ID=
# Google OAuth 클라이언트 secret (웹 콜백 코드 교환)
# GOOGLE_CLIENT_SECRET=
# Google 웹 콜백 URL. 운영 https 도메인, 개발 localhost
GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/google/web-callback
# Apple 로그인 id 토큰 audience (번들 ID). 개발 빌드는 .dev 등 별도 값
# APPLE_CLIENT_ID=
# Apple 팀 ID (production OAuth 구성 검사에 쓰임)
# APPLE_TEAM_ID=
# Apple Sign in 키 ID (production OAuth 구성 검사에 쓰임)
# APPLE_KEY_ID=
# Apple Sign in 개인 키 (\n 이스케이프 한 줄, production OAuth 구성 검사에 쓰임)
# APPLE_PRIVATE_KEY=
# Kakao REST API 키
# KAKAO_CLIENT_ID=
# Kakao client secret
# KAKAO_CLIENT_SECRET=
# Kakao 웹 콜백 URL. 운영 https 도메인, 개발 localhost
KAKAO_CALLBACK_URL=http://localhost:8080/v1/auth/kakao/web-callback
# Naver client ID
# NAVER_CLIENT_ID=
# Naver client secret
# NAVER_CLIENT_SECRET=
# Naver 웹 콜백 URL. 운영 https 도메인, 개발 localhost
NAVER_CALLBACK_URL=http://localhost:8080/v1/auth/naver/web-callback

# --- Email ---
# 발송 어댑터 (resend | log). 비우면 스테이징·운영 resend, 개발은 키가 있을 때만 resend. log는 로그만 남긴다. 운영은 resend 필수
EMAIL_PROVIDER=log
# Resend API 키 (EMAIL_PROVIDER=resend일 때. 운영 필수)
# RESEND_API_KEY=
# 발신 주소 (기본 noreply@aido.kr)
EMAIL_FROM=noreply@aido.kr
# 발신자 이름
EMAIL_FROM_NAME=Aido
# 문의·신고 수신 주소 (기본 support@aido.kr)
SUPPORT_EMAIL=support@aido.kr

# --- External services ---
# 공공데이터포털 서비스키 (기상청 예보·생활기상지수·출몰시각·에어코리아)
# KMA_API_KEY=
# Apple WeatherKit (날씨 v2). 운영은 네 값 필수, 개발은 모두 비우면 /v2/weather가 WEATHER_1901
# Apple Developer → Keys에서 WeatherKit 키(.p8)를 만들고 Key ID·Team ID를 적는다
# WEATHERKIT_TEAM_ID=XXXXXXXXXX
# WEATHERKIT_KEY_ID=XXXXXXXXXX
# SERVICE_ID는 앱 번들 ID가 아니라 Identifiers → Services IDs에 등록한 ID다 (예: com.example.weatherkit)
# WEATHERKIT_SERVICE_ID=com.example.weatherkit-client
# .p8 내용을 한 줄로 넣고 줄바꿈은 \n으로 적는다
# WEATHERKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
# RevenueCat 웹훅 Authorization 검증 비밀 (운영 필수). 비우면 개발 환경만 검증을 건너뛰고 스테이징·운영은 모두 거절한다
# REVENUECAT_WEBHOOK_SECRET=
# 웹훅 뒤 스토어 상태 대조용 RevenueCat REST API v2 비밀 키. 대시보드 Project settings → API keys에서 V2로 만들고
# 권한은 customer_information:subscriptions:read, project_configuration:products:read 둘만 준다.
# REVENUECAT_PROJECT_ID와 함께 있어야 대조가 켜진다
# REVENUECAT_API_V2_SECRET_KEY=
# 운영 알림의 RevenueCat 고객 링크용 공개 프로젝트 ID (비밀 아님)
REVENUECAT_PROJECT_ID=6a6ea506
# 관리자 알림 어댑터 (discord | log). 비우면 스테이징·운영 discord, 개발은 웹훅이 있을 때만 discord. log는 로그만 남긴다
# ADMIN_NOTIFIER_PROVIDER=discord
# 가입 알림 Discord 웹훅 (https://discord.com/api/webhooks/…)
# DISCORD_SIGNUP_WEBHOOK_URL=
# 결제 알림 Discord 웹훅 (https://discord.com/api/webhooks/…)
# DISCORD_PAYMENT_WEBHOOK_URL=
# Expo Push 액세스 토큰 (Enhanced Push Security 사용 시만)
# EXPO_ACCESS_TOKEN=
# 푸시 빈도 제한 저장소 (postgres | redis | memory, 선택, 기본 postgres)
# PUSH_RATE_LIMIT_BACKEND=

# --- Monitoring ---
# API Sentry DSN (https). 전송은 APP_ENV=production일 때만
# SENTRY_DSN=
# 트레이스 샘플링 0~1 (선택, 기본 운영 0.2·그 외 1.0)
# SENTRY_TRACES_SAMPLE_RATE=

# --- AI (ai.schema.ts 한 곳. 키 외에는 선택, 미설정 시 기본값 — 롤백·실험할 때만 설정) ---
# 키가 있는 업체만 AI_PROVIDER_ORDER 순서로 쓴다. 서버에는 글자만 보내고 녹음 파일은 받지 않는다
# Claude API 키 (sk-ant-…). 크레딧이 떨어지면(402) 15분 동안 다음 업체로 넘긴다
# ANTHROPIC_API_KEY=
# Gemini API 키. 1.13.0은 AIza…·AQ.… 모두, 1.12.x 이하는 AIza…만 받는다 (새 형식은 1.13.0 기동 뒤에만)
# GOOGLE_GENERATIVE_AI_API_KEY=
# OpenAI API 키 (sk-proj-…)
# OPENAI_API_KEY=
# 시도 순서, 쉼표 구분 (기본 anthropic,google,openai). 동의 버전이 허용한 업체만 쓴다(1.13·1.14 동의는 google만)
# AI_PROVIDER_ORDER=
# 업체별 모델 ID (기본 claude-haiku-5-5 / gemini-3.1-flash-lite / gpt-6-luna)
# AI_MODEL_ANTHROPIC=
# AI_MODEL_GOOGLE=
# AI_MODEL_OPENAI=
# 작업별 추론 강도 (minimal | low | medium, 기본 PARSE_TODO만 minimal·나머지 low)
# AI_THINKING_PARSE_TODO=
# AI_THINKING_PARSE_MEMO=
# AI_THINKING_REPORT=
# AI_THINKING_SUGGESTION=
# AI_THINKING_QUICK_PLAN=
# AI_THINKING_VOICE_NOTE_DIGEST=
# 업체를 바꿔 가며 시도하는 전체 제한 시간(ms) (기본 12000 / 25000 / 60000 / 60000 / 24000 / 45000)
# AI_DEADLINE_PARSE_TODO_MS=
# AI_DEADLINE_PARSE_MEMO_MS=
# AI_DEADLINE_REPORT_MS=
# AI_DEADLINE_SUGGESTION_MS=
# AI_DEADLINE_QUICK_PLAN_MS=
# AI_DEADLINE_VOICE_NOTE_DIGEST_MS=
# 회로 차단: 결제·인증 실패 뒤 건너뛰는 시간(기본 900000), 연속 장애 횟수(기본 5)·건너뛰는 시간(기본 30000)
# AI_BREAKER_BILLING_COOLDOWN_MS=
# AI_BREAKER_HEALTH_THRESHOLD=
# AI_BREAKER_HEALTH_COOLDOWN_MS=
# 킬 스위치(on | interactive-only | off, 기본 on). 바꾸면 재시작해야 반영된다
# AI_GENERATION_MODE=
# 추정 비용 예산(USD, UTC 일·월). 경고 1/10 → 리포트·제안 중단 2/20 → 전체 중단 3/30, 사용자 일 0.25
# AI_BUDGET_DAILY_ALERT_USD=
# AI_BUDGET_MONTHLY_ALERT_USD=
# AI_BUDGET_DAILY_BACKGROUND_USD=
# AI_BUDGET_MONTHLY_BACKGROUND_USD=
# AI_BUDGET_DAILY_USD=
# AI_BUDGET_MONTHLY_USD=
# AI_BUDGET_USER_DAILY_USD=

# --- 기능 플래그 (개발은 운영과 같은 값으로 모든 기능을 켠다) ---
# 스토어 최신 공개 버전의 전환기 대체값. 정본은 DB(AppRelease)이고 관리자 API로 바꾼다(apps/api/docs/deployment.md).
# 아래 세 값은 DB에 그 플랫폼 행이 없는 동안에만 읽는다 (켜면 두 플랫폼 버전 필수)
APP_VERSION_CHECK_ENABLED=true
# DB에 ios 행이 없을 때 쓰는 App Store 공개 버전 (MAJOR.MINOR.PATCH)
APP_VERSION_CHECK_IOS_LATEST_VERSION=1.15.0
# DB에 android 행이 없을 때 쓰는 Google Play 공개 버전 (MAJOR.MINOR.PATCH)
APP_VERSION_CHECK_ANDROID_LATEST_VERSION=1.15.0
# 콕 찌르기 답장·감사 (1.11.0)
NUDGE_INTERACTIONS_ENABLED=true
# 신규 가입자 리텐션 온보딩 V2 실험 (신규 가입자만 등록)
RETENTION_ONBOARDING_V2_ENABLED=true
# V2 실험군 비율 0~100
RETENTION_ONBOARDING_V2_TREATMENT_PERCENT=50
# 친구 초대 링크·수락·보상 API (1.13.0, 꺼지면 INVITE_2105, 지급 원장은 유지)
INVITE_ENABLED=true
# 중복 보상 판단 HMAC 키 (운영에서 켜면 32자 이상 필수, 한 번 정하면 유지)
# INVITE_CLAIM_HASH_SECRET=
# 새 기능 소개 캠페인 (켜면 아래 세 값 필수)
FEATURE_DISCOVERY_ENABLED=true
# 캠페인 ID (1.15.0 앱에 번들된 값)
FEATURE_DISCOVERY_CAMPAIGN_ID=feature-discovery-2026-12
# 소개를 보여 줄 최소 앱 버전 (semver)
FEATURE_DISCOVERY_MIN_APP_VERSION=1.15.0
# UTC ISO(끝이 Z). 이후 가입자는 소개 대신 활성화 흐름 — 운영은 1.15.0 배포 시각
FEATURE_DISCOVERY_LAUNCHED_AT=2026-12-01T00:00:00.000Z
# 앱 실행 시 소개 자동 열기
FEATURE_DISCOVERY_AUTO_OPEN=true
