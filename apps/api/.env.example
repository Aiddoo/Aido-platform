# Aido API env 예시. 개발: cp .env.example .env.development · 운영: cp .env.example .env
# NODE_ENV가 파일을 고른다(production → .env, test → .env.test, 그 밖 → .env.development). 도커도 같은 파일을 읽는다.
# 값은 개발 기준이고 운영에서 다른 값은 주석에 "운영"으로 적는다. "# KEY="는 선택 값이다. 비밀 생성: openssl rand -base64 48
# 설명은 한 줄 주석으로 키 위에 둔다. 값 뒤에 주석을 붙이지 않는다(값에 #이 있으면 잘린다).

# --- App ---
NODE_ENV=development
# 배포 환경 (development | staging | production). 운영 production. 개발 도구·공급자 기본값·시작 검증의 기준
APP_ENV=development
# 컨테이너 안 포트. 운영 compose는 8080으로 고정한다
PORT=8080
# 외부에서 이 API에 닿는 주소 (운영 https 도메인). 신고 접수 메일의 관리자 링크에 쓴다
# API_PUBLIC_URL=http://localhost:8080
# 로그 레벨 (silent | fatal | error | warn | info | debug | trace)
# LOG_LEVEL=
# /health에 보이는 인스턴스 이름. 비우면 기동마다 임의 값
# INSTANCE_ID=

# --- Database ---
# 개발은 pnpm docker:up 컨테이너(5433), 운영은 RDS 주소에 ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aido
# 앱 연결 풀 (기본 10 / 유휴 10초 / 대기 5초)
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# 서버 인증서 검증을 끈다. 비상시에만 true
# DATABASE_SSL_ALLOW_UNVERIFIED=false

# --- Jobs (pg-boss) ---
JOB_SCHEMA=pgboss
# false면 작업을 넣기만 하고 worker·정기 작업을 돌리지 않는다 (API 전용 프로세스, 기본 true)
# JOB_WORKER_ENABLED=true
# pg-boss 전용 연결 수 (기본 3)
# JOB_POOL_MAX=3
# 종료 때 하던 작업을 기다리는 시간 (기본 90000). compose stop_grace_period(120초)보다 짧게 둔다
# JOB_SHUTDOWN_TIMEOUT_MS=90000

# --- Cache ---
# 캐시·잠금·중복 방지·요청 제한 저장소 (memory | redis). 프로세스가 하나인 동안 memory
CACHE_TYPE=memory
# 메모리 캐시 항목 한도. 운영 3000
CACHE_MAX_ITEMS=3000
CACHE_DEFAULT_TTL_MS=60000
# Redis·Valkey 주소 (redis:// 또는 rediss://). redis를 고르면 필수다. 로컬: docker compose --profile redis up -d
# REDIS_URL=redis://localhost:6379
# Redis 명령·연결 타임아웃 ms (기본 1500 / 5000)
# REDIS_COMMAND_TIMEOUT_MS=1500
# REDIS_CONNECT_TIMEOUT_MS=5000

# --- Auth ---
# 서명·암호화 키는 32자 이상이고 서로 다른 값이다. 운영은 새로 만든 비밀을 쓴다
JWT_SECRET=dev-jwt-secret-key-minimum-32-characters-long-for-security
JWT_REFRESH_SECRET=dev-refresh-secret-key-minimum-32-characters-long-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 저장 토큰 암호화 키. 바꾸면 기존 암호문을 못 읽는다
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-minimum-32-characters-long
# 암호화 salt (8자 이상). 운영은 비워 둔다. 바꾸면 기존 암호문을 못 읽는다
# TOKEN_ENCRYPTION_SALT=
# 댓글 커서·광고 수신 거부 토큰 서명 키 "kid:secret,kid2:secret2" (첫 항목이 서명 키). 비우면 JWT_SECRET으로 서명한다
# CURSOR_SIGNING_KEYS=
# OPT_OUT_TOKEN_SIGNING_KEYS=

# --- Security ---
# 허용 Origin (쉼표 구분). 운영은 실제 https 도메인
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081
# 요청 제한: 창 ms와 창당 최대 요청 수. 운영 100
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000

# --- OAuth (운영은 provider 하나 이상 필수) ---
# 콜백 URL은 운영에서 https 도메인이다
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/google/web-callback
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:8080/v1/auth/kakao/web-callback
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:8080/v1/auth/naver/web-callback
# Apple id 토큰 audience (번들 ID). 개발 빌드는 .dev 등 다른 값
# APPLE_CLIENT_ID=
# Apple Sign in 키 (운영 OAuth 구성 검사에 쓴다). 개인 키는 \n으로 이은 한 줄
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- Email ---
# 발송 어댑터 (resend | log). 운영은 resend 필수. log는 로그만 남긴다
EMAIL_PROVIDER=log
# RESEND_API_KEY=
EMAIL_FROM=noreply@aido.kr
EMAIL_FROM_NAME=Aido
# 문의·신고 수신 주소
SUPPORT_EMAIL=support@aido.kr

# --- Push ---
# Expo Push 액세스 토큰 (Enhanced Push Security를 켰을 때만)
# EXPO_ACCESS_TOKEN=
# 푸시 빈도 제한 저장소 (postgres | redis | memory, 기본 postgres)
# PUSH_RATE_LIMIT_BACKEND=postgres

# --- Billing (RevenueCat) ---
# 웹훅 Authorization 검증 비밀 (운영 필수). 비우면 개발만 검증을 건너뛴다
# REVENUECAT_WEBHOOK_SECRET=
# 스토어 상태 대조용 REST API v2 비밀 키. 권한은 customer_information:subscriptions:read, project_configuration:products:read
# REVENUECAT_API_V2_SECRET_KEY=
# 공개 프로젝트 ID (비밀 아님). 위 키와 함께 있어야 대조가 켜진다
REVENUECAT_PROJECT_ID=6a6ea506

# --- Weather ---
# 공공데이터포털 서비스키 (기상청 예보·생활기상지수·출몰시각·에어코리아)
# KMA_API_KEY=
# Apple WeatherKit (날씨 v2). 운영은 네 값 필수. SERVICE_ID는 번들 ID가 아니라 Services ID, 개인 키는 \n으로 이은 한 줄
# WEATHERKIT_TEAM_ID=XXXXXXXXXX
# WEATHERKIT_KEY_ID=XXXXXXXXXX
# WEATHERKIT_SERVICE_ID=com.example.weatherkit-client
# WEATHERKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"

# --- Operations ---
# 관리자 알림 어댑터 (discord | log). 비우면 스테이징·운영 discord, 개발은 웹훅이 있을 때만 discord
# ADMIN_NOTIFIER_PROVIDER=discord
# DISCORD_SIGNUP_WEBHOOK_URL=
# DISCORD_PAYMENT_WEBHOOK_URL=
# Sentry DSN. 전송은 APP_ENV=production일 때만
# SENTRY_DSN=
# 트레이스 샘플링 0~1 (기본 운영 0.2, 그 밖 1.0)
# SENTRY_TRACES_SAMPLE_RATE=

# --- AI (키만 넣으면 된다. 나머지는 롤백·실험할 때만 설정한다) ---
# 키가 있는 업체만 AI_PROVIDER_ORDER 순서로 쓴다
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# 시도 순서 (기본 anthropic,google,openai)
# AI_PROVIDER_ORDER=
# 업체별 모델 ID (기본 claude-haiku-5-5 / gemini-3.1-flash-lite / gpt-6-luna)
# AI_MODEL_ANTHROPIC=
# AI_MODEL_GOOGLE=
# AI_MODEL_OPENAI=
# 작업별 추론 강도 (minimal | low | medium, 기본 PARSE_TODO만 minimal)
# AI_THINKING_PARSE_TODO=
# AI_THINKING_PARSE_MEMO=
# AI_THINKING_REPORT=
# AI_THINKING_SUGGESTION=
# AI_THINKING_QUICK_PLAN=
# AI_THINKING_VOICE_NOTE_DIGEST=
# 작업별 전체 제한 시간 ms (기본 12000 / 25000 / 60000 / 60000 / 24000 / 45000)
# AI_DEADLINE_PARSE_TODO_MS=
# AI_DEADLINE_PARSE_MEMO_MS=
# AI_DEADLINE_REPORT_MS=
# AI_DEADLINE_SUGGESTION_MS=
# AI_DEADLINE_QUICK_PLAN_MS=
# AI_DEADLINE_VOICE_NOTE_DIGEST_MS=
# 회로 차단: 결제·인증 실패 뒤 쉬는 시간(기본 900000), 연속 장애 횟수(5)·쉬는 시간(30000)
# AI_BREAKER_BILLING_COOLDOWN_MS=
# AI_BREAKER_HEALTH_THRESHOLD=
# AI_BREAKER_HEALTH_COOLDOWN_MS=
# 킬 스위치 (on | interactive-only | off, 기본 on). 재시작해야 반영된다
# AI_GENERATION_MODE=
# 추정 비용 예산 USD (일/월): 경고 1/10 → 리포트·제안 중단 2/20 → 전체 중단 3/30, 사용자 일 0.25
# AI_BUDGET_DAILY_ALERT_USD=
# AI_BUDGET_MONTHLY_ALERT_USD=
# AI_BUDGET_DAILY_BACKGROUND_USD=
# AI_BUDGET_MONTHLY_BACKGROUND_USD=
# AI_BUDGET_DAILY_USD=
# AI_BUDGET_MONTHLY_USD=
# AI_BUDGET_USER_DAILY_USD=

# --- Features (개발은 운영과 같은 값으로 모든 기능을 켠다) ---
# 콕 찌르기 답장·감사
NUDGE_INTERACTIONS_ENABLED=true
# 신규 가입자 리텐션 온보딩 V2 실험과 실험군 비율(0~100)
RETENTION_ONBOARDING_V2_ENABLED=true
RETENTION_ONBOARDING_V2_TREATMENT_PERCENT=50
# 친구 초대. 꺼지면 INVITE_2105
INVITE_ENABLED=true
# 중복 보상 판단 HMAC 키 (운영에서 켜면 32자 이상 필수, 한 번 정하면 바꾸지 않는다)
# INVITE_CLAIM_HASH_SECRET=
# 새 기능 소개 캠페인 (켜면 아래 값 필수). LAUNCHED_AT 이후 가입자는 소개 대신 활성화 흐름을 본다
FEATURE_DISCOVERY_ENABLED=true
FEATURE_DISCOVERY_CAMPAIGN_ID=feature-discovery-2026-12
FEATURE_DISCOVERY_MIN_APP_VERSION=1.15.0
FEATURE_DISCOVERY_LAUNCHED_AT=2026-12-01T00:00:00.000Z
FEATURE_DISCOVERY_AUTO_OPEN=true

# --- 전환용 (DB에 값이 생기면 지운다: docs/conventions/compatibility.md) ---
# 스토어 공개 버전의 정본은 DB이고 관리자 API로 바꾼다. 아래는 DB에 그 플랫폼 행이 없을 때만 읽는다
APP_VERSION_CHECK_ENABLED=true
APP_VERSION_CHECK_IOS_LATEST_VERSION=1.15.0
APP_VERSION_CHECK_ANDROID_LATEST_VERSION=1.15.0
