// use prisma-8
// 기존 migration을 적용한 격리 DB에서 추출했다. 물리 이름과 제약을 그대로 관리한다.

namespace public {
  model User {
    id                             String                          @id(map: "User_pkey")
    email                          VarChar(255)
    userTag                        VarChar(8)
    role                           pg.enum(UserRole)               @default("USER")
    status                         pg.enum(UserStatus)             @default("PENDING_VERIFY")
    emailVerifiedAt                TimestampString(3)?
    twoFactorEnabled               Boolean                         @default(false)
    twoFactorSecret                VarChar(255)?
    subscriptionStatus             pg.enum(SubscriptionStatus)     @default("FREE")
    subscriptionExpiresAt          TimestampString(3)?
    revenueCatUserId               VarChar(255)?
    aiUsageCount                   Int                             @default(0)
    aiUsageResetAt                 TimestampString(3)                    @default(now())
    createdAt                      TimestampString(3)                    @default(now())
    updatedAt                      temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    lastLoginAt                    TimestampString(3)?
    deletedAt                      TimestampString(3)?
    lastActiveAt                   TimestampString(3)?
    accounts                       Account[]
    aiReports                      AiReport[]
    dailyCompletions               DailyCompletion[]
    memos                          Memo[]
    notifications                  Notification[]
    pushDailyBudgets               PushDailyBudget[]
    pushDispatches                 PushDispatch[]
    pushTokens                     PushToken[]
    recurringSuggestions           RecurringSuggestion[]
    retentionAssignments RetentionExperimentAssignment[]
    securityLogs                   SecurityLog[]
    sessions                       Session[]
    subscriptions                  Subscription[]
    todos                          Todo[]
    todoCategories                 TodoCategory[]
    authoredTodoComments                   TodoComment[]
    todoCommentLikes               TodoCommentLike[]
    todoViews                      TodoView[]
    activityDays               UserActivityDay[]
    consent                    UserConsent?
    location                   UserLocation?
    preference                 UserPreference?
    profile                    UserProfile?
    verifications                  Verification[]
    weeklyAchievements             WeeklyAchievement[]
    receivedCheers                         Cheer[]                         @relation(name: "Cheer_receiverId_fkey")
    sentCheers                    Cheer[]                         @relation(name: "Cheer_senderId_fkey")
    following                        Follow[]                        @relation(name: "Follow_followerId_fkey")
    followers                  Follow[]                        @relation(name: "Follow_followingId_fkey")
    receivedNudges                         Nudge[]                         @relation(name: "Nudge_receiverId_fkey")
    sentNudges                    Nudge[]                         @relation(name: "Nudge_senderId_fkey")
    receivedRemindNudges                 ReminderNudge[]                 @relation(name: "ReminderNudge_receiverId_fkey")
    sentRemindNudges    ReminderNudge[]                 @relation(name: "ReminderNudge_senderId_fkey")

    @@index([deletedAt, createdAt], map: "User_deletedAt_createdAt_idx")
    @@index([deletedAt], map: "User_deletedAt_idx")
    @@index([deletedAt, lastActiveAt], map: "User_deletedAt_lastActiveAt_idx")
    @@unique([email], map: "User_email_key")
    @@unique([revenueCatUserId], map: "User_revenueCatUserId_key")
    @@index([status, deletedAt, lastLoginAt], map: "User_status_deletedAt_lastLoginAt_idx")
    @@index([status], map: "User_status_idx")
    @@index([subscriptionStatus], map: "User_subscriptionStatus_idx")
    @@unique([userTag], map: "User_userTag_key")
  }

  model Account {
    id                   Int                      @id(map: "Account_pkey") @default(autoincrement())
    userId               String
    provider             pg.enum(AccountProvider)
    providerAccountId    VarChar(255)
    password             VarChar(128)?
    accessToken          String?
    refreshToken         String?
    accessTokenExpiresAt TimestampString(3)?
    scope                VarChar(500)?
    createdAt            TimestampString(3)             @default(now())
    updatedAt            temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Account_userId_fkey", index: false)

    @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
    @@unique([userId, provider], map: "Account_userId_provider_key")
  }

  model AiReport {
    id                Int                 @id(map: "AiReport_pkey") @default(autoincrement())
    userId            String
    _type             pg.enum(ReportType) @map("type")
    year              Int
    period            Int
    stats             Jsonb
    categoryBreakdown Jsonb
    dayPatterns       Jsonb
    timePatterns      Jsonb
    aiSummary         String
    aiTips            Jsonb
    hasActivity       Boolean
    generatedAt       TimestampString(3)
    createdAt         TimestampString(3)        @default(now())
    locale            VarChar(10)         @default("ko")
    user              User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AiReport_userId_fkey", index: false)

    @@index([userId, _type, generatedAt], map: "AiReport_userId_type_generatedAt_idx")
    @@index([userId, _type], map: "AiReport_userId_type_idx")
    @@unique([userId, _type, year, period], map: "AiReport_userId_type_year_period_key")
  }

  model Cheer {
    id         Int           @id(map: "Cheer_pkey") @default(autoincrement())
    senderId   String
    receiverId String
    message    VarChar(200)?
    createdAt  TimestampString(3)  @default(now())
    readAt     TimestampString(3)?
    receiver   User          @relation(name: "Cheer_receiverId_fkey", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Cheer_receiverId_fkey", index: false)
    sender     User          @relation(name: "Cheer_senderId_fkey", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Cheer_senderId_fkey", index: false)

    @@index([receiverId, createdAt], map: "Cheer_receiverId_createdAt_idx")
    @@index([senderId, createdAt], map: "Cheer_senderId_createdAt_idx")
    @@index([senderId, receiverId, createdAt], map: "Cheer_senderId_receiverId_createdAt_idx")
  }

  model DailyCompletion {
    id             String       @id(map: "DailyCompletion_pkey")
    userId         String
    date           DateString
    totalTodos     Int
    completedTodos Int
    achievedAt     TimestampString(3)
    createdAt      TimestampString(3) @default(now())
    updatedAt      temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "DailyCompletion_userId_fkey", index: false)

    @@unique([userId, date], map: "DailyCompletion_userId_date_key")
  }

  model Follow {
    id          String                @id(map: "Follow_pkey")
    followerId  String
    followingId String
    status      pg.enum(FollowStatus) @default("PENDING")
    createdAt   TimestampString(3)          @default(now())
    updatedAt   temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    sortOrder   Int                   @default(0)
    follower    User                  @relation(name: "Follow_followerId_fkey", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Follow_followerId_fkey", index: false)
    following   User                  @relation(name: "Follow_followingId_fkey", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Follow_followingId_fkey", index: false)

    @@unique([followerId, followingId], map: "Follow_followerId_followingId_key")
    @@index([followerId, sortOrder], map: "Follow_followerId_sortOrder_idx")
    @@index([followerId, status], map: "Follow_followerId_status_idx")
    @@index([followingId, status], map: "Follow_followingId_status_idx")
  }

  model LoginAttempt {
    id            Int                       @id(map: "LoginAttempt_pkey") @default(autoincrement())
    email         VarChar(255)
    provider      pg.enum(AccountProvider)?
    ipAddress     VarChar(45)
    userAgent     VarChar(500)
    success       Boolean
    failureReason VarChar(100)?
    createdAt     TimestampString(3)              @default(now())

    @@index([createdAt], map: "LoginAttempt_createdAt_idx")
    @@index([email, createdAt], map: "LoginAttempt_email_createdAt_idx")
    @@index([ipAddress, createdAt], map: "LoginAttempt_ipAddress_createdAt_idx")
    @@index([provider, createdAt], map: "LoginAttempt_provider_createdAt_idx")
  }

  model Memo {
    id        Int           @id(map: "Memo_pkey") @default(autoincrement())
    userId    String
    content   VarChar(5000)
    isPinned  Boolean       @default(false)
    sortOrder Int           @default(0)
    createdAt TimestampString(3)  @default(now())
    updatedAt temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Memo_userId_fkey", index: false)

    @@index([userId, isPinned, sortOrder], map: "Memo_userId_isPinned_sortOrder_idx")
    @@index([userId, sortOrder], map: "Memo_userId_sortOrder_idx")
  }

  model Notification {
    id               Int                             @id(map: "Notification_pkey") @default(autoincrement())
    userId           String
    _type            pg.enum(NotificationType)       @map("type")
    title            VarChar(200)
    body             VarChar(500)
    isRead           Boolean                         @default(false)
    todoId           Int?
    friendId         String?
    nudgeId          Int?
    cheerId          Int?
    notificationDate DateString?
    metadata         Jsonb?
    createdAt        TimestampString(3)                    @default(now())
    readAt           TimestampString(3)?
    actionType       pg.enum(NotificationActionType) @default("DEEP_LINK")
    actionUrl        VarChar(1000)?
    campaignKey      VarChar(100)?
    variantId        VarChar(100)?
    purpose          pg.enum(NotificationPurpose)    @default("TRANSACTIONAL")
    openedAt         TimestampString(3)?
    pushDispatch     PushDispatch?
    user             User                            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Notification_userId_fkey", index: false)

    @@index(expression: "(metadata ->> 'senderId'::text)", map: "Notification_comment_actor_cleanup_idx", where: "((metadata ->> 'senderId'::text) IS NOT NULL)")
    @@index([createdAt], map: "Notification_createdAt_idx")
    @@index([friendId], map: "Notification_friend_actor_cleanup_idx", where: "(\"friendId\" IS NOT NULL)")
    @@index([todoId, _type, createdAt], map: "Notification_todoId_type_createdAt_idx")
    @@index(expression: "\"todoId\", type, (metadata ->> 'stage'::text)", map: "Notification_todo_reminder_dedup", where: "((type = 'TODO_REMINDER'::\"NotificationType\") AND (\"todoId\" IS NOT NULL))", unique: true)
    @@index([userId, createdAt, id], map: "Notification_userId_createdAt_id_idx")
    @@index([userId, isRead, createdAt], map: "Notification_userId_isRead_createdAt_idx")
    @@index([userId, _type], map: "Notification_userId_type_idx")
    @@index([userId, _type, notificationDate], map: "Notification_userId_type_notificationDate_idx")
    @@check(expression: "((type <> 'TODO_SHARED'::\"NotificationType\") OR (\"actionType\" <> 'DEEP_LINK'::\"NotificationActionType\") OR ((metadata ->> 'commentId'::text) IS NULL) OR (\"actionUrl\" IS NULL))", map: "Notification_todo_comment_action_url_check")
    @@check(expression: "(((metadata ->> 'commentId'::text) IS NULL) OR COALESCE(((jsonb_typeof((metadata -> 'senderId'::text)) = 'string'::text) AND (length((metadata ->> 'senderId'::text)) > 0)), false))", map: "Notification_todo_comment_sender_check")
  }

  model TodoCategory {
    id        Int          @id(map: "TodoCategory_pkey") @default(autoincrement())
    userId    String
    name      VarChar(50)
    color     VarChar(7)
    sortOrder Int          @default(0)
    createdAt TimestampString(3) @default(now())
    updatedAt temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    todos     Todo[]
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TodoCategory_userId_fkey", index: false)

    @@unique([userId, name], map: "TodoCategory_userId_name_key")
    @@index([userId, sortOrder], map: "TodoCategory_userId_sortOrder_idx")
  }

  model Todo {
    id                Int                     @id(map: "Todo_pkey") @default(autoincrement())
    userId            String
    title             VarChar(200)
    categoryId        Int
    sortOrder         Int                     @default(0)
    completed         Boolean                 @default(false)
    completedAt       TimestampString(3)?
    startDate         DateString
    endDate           DateString?
    scheduledTime     TimestamptzString(3)?
    isAllDay          Boolean                 @default(true)
    visibility        pg.enum(TodoVisibility) @default("PUBLIC")
    createdAt         TimestampString(3)            @default(now())
    updatedAt         temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    recurrenceGroupId VarChar(36)?
    viewCount         Int                     @default(0)
    commentCount      Int                     @default(0)
    nudges            Nudge[]
    comments      TodoComment[]
    items         TodoItem[]
    views         TodoView[]
    category          TodoCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Todo_categoryId_fkey", index: false)
    user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Todo_userId_fkey", index: false)

    @@index([completed, scheduledTime], map: "Todo_completed_scheduledTime_idx")
    @@index([recurrenceGroupId], map: "Todo_recurrenceGroupId_idx")
    @@index([userId, categoryId], map: "Todo_userId_categoryId_idx")
    @@index([userId, completed, startDate], map: "Todo_userId_completed_startDate_idx")
    @@index([userId, sortOrder], map: "Todo_userId_sortOrder_idx")
    @@index([userId, startDate, endDate], map: "Todo_userId_startDate_endDate_idx")
  }

  model Nudge {
    id             Int                      @id(map: "Nudge_pkey") @default(autoincrement())
    senderId       String
    receiverId     String
    todoId         Int
    message        VarChar(200)?
    createdAt      TimestampString(3)             @default(now())
    readAt         TimestampString(3)?
    replyKind      pg.enum(NudgeReplyKind)?
    repliedAt      TimestampString(3)?
    replyUpdatedAt TimestampString(3)?
    thankedAt      TimestampString(3)?
    receiver       User                     @relation(name: "Nudge_receiverId_fkey", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Nudge_receiverId_fkey", index: false)
    sender         User                     @relation(name: "Nudge_senderId_fkey", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Nudge_senderId_fkey", index: false)
    todo           Todo                     @relation(fields: [todoId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Nudge_todoId_fkey")

    @@index([receiverId, createdAt], map: "Nudge_receiverId_createdAt_idx")
    @@index([receiverId, id], map: "Nudge_receiverId_id_idx")
    @@index([senderId, createdAt], map: "Nudge_senderId_createdAt_idx")
    @@index([senderId, id], map: "Nudge_senderId_id_idx")
    @@index([senderId, todoId, createdAt], map: "Nudge_senderId_todoId_createdAt_idx")
    @@index([todoId, senderId], map: "Nudge_thanked_sender_per_todo", where: "(\"thankedAt\" IS NOT NULL)", unique: true)
    @@index([todoId], map: "Nudge_todoId_idx")
    @@index([todoId, receiverId, thankedAt, id], map: "Nudge_todoId_receiverId_thankedAt_id_idx")
  }

  model OAuthState {
    id               Int                      @id(map: "OAuthState_pkey") @default(autoincrement())
    state            VarChar(64)
    codeVerifier     VarChar(128)?
    provider         pg.enum(AccountProvider)
    redirectUri      VarChar(500)
    mode             VarChar(10)?
    initiatingUserId VarChar(36)?
    exchangeCode     VarChar(64)?
    accessToken      VarChar(1000)?
    refreshToken     VarChar(1000)?
    userId           VarChar(255)?
    userName         VarChar(20)?
    profileImage     VarChar(500)?
    accountRestored  Boolean?
    ipAddress        VarChar(45)?
    userAgent        VarChar(500)?
    expiresAt        TimestampString(3)
    exchangedAt      TimestampString(3)?
    createdAt        TimestampString(3)             @default(now())

    @@unique([exchangeCode], map: "OAuthState_exchangeCode_key")
    @@index([expiresAt], map: "OAuthState_expiresAt_idx")
    @@unique([state], map: "OAuthState_state_key")
  }

  model PushDailyBudget {
    id             Int           @id(map: "PushDailyBudget_pkey") @default(autoincrement())
    userId         String
    localDate      DateString
    automatedCount Int           @default(0)
    lastSentAt     TimestampString(3)?
    createdAt      TimestampString(3)  @default(now())
    updatedAt      temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    user           User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushDailyBudget_userId_fkey", index: false)

    @@unique([userId, localDate], map: "PushDailyBudget_userId_localDate_key")
  }

  model PushDispatch {
    id                        Int                          @id(map: "PushDispatch_pkey") @default(autoincrement())
    notificationId            Int
    userId                    String
    purpose                   pg.enum(NotificationPurpose)
    campaignKey               VarChar(100)?
    variantId                 VarChar(100)?
    timezone                  VarChar(50)                  @default("UTC")
    localDate                 DateString?
    status                    pg.enum(PushDispatchStatus)  @default("PENDING")
    skipReason                VarChar(100)?
    scheduledAt               TimestampString(3)                 @default(now())
    sentAt                    TimestampString(3)?
    openedAt                  TimestampString(3)?
    createdAt                 TimestampString(3)                 @default(now())
    updatedAt                 temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    processingJobId           VarChar(255)?
    processingJobAttempt      Int?
    processingStartedAt       TimestampString(3)?
    deliveryAttemptCount      Int                          @default(0)
    rateLimitReservedAt       TimestampString(3)?
    lastError                 VarChar(500)?
    attempts      PushDeliveryAttempt[]
    outbox        PushDispatchOutbox?
    rateLimitReservations PushRateLimitReservation[]
    notification              Notification                 @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushDispatch_notificationId_fkey")
    user                      User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushDispatch_userId_fkey", index: false)

    @@index([campaignKey, status, createdAt], map: "PushDispatch_campaignKey_status_createdAt_idx")
    @@unique([notificationId], map: "PushDispatch_notificationId_key")
    @@index([processingStartedAt], map: "PushDispatch_processing_lease_idx", where: "(status = 'PROCESSING'::\"PushDispatchStatus\")")
    @@index([status, scheduledAt], map: "PushDispatch_status_scheduledAt_idx")
    @@index([userId, localDate, purpose], map: "PushDispatch_userId_localDate_purpose_idx")
  }

  model PushToken {
    id                   Int                   @id(map: "PushToken_pkey") @default(autoincrement())
    userId               String
    token                VarChar(255)
    deviceId             VarChar(255)
    platform             pg.enum(Platform)
    isActive             Boolean               @default(true)
    createdAt            TimestampString(3)          @default(now())
    updatedAt            temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    lastUsedAt           TimestampString(3)          @default(now())
    payloadVersion       Int                   @default(1)
    appVersion           VarChar(30)?
    deliveryAttempts PushDeliveryAttempt[]
    user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushToken_userId_fkey", index: false)

    @@unique([token], map: "PushToken_token_key")
    @@unique([userId, deviceId], map: "PushToken_userId_deviceId_key")
    @@index([userId, isActive], map: "PushToken_userId_isActive_idx")
  }

  model PushDeliveryAttempt {
    id               Int                         @id(map: "PushDeliveryAttempt_pkey") @default(autoincrement())
    dispatchId       Int
    pushTokenId      Int
    status           pg.enum(PushDeliveryStatus) @default("PENDING")
    expoTicketId     VarChar(100)?
    errorCode        VarChar(100)?
    errorMessage     VarChar(500)?
    receiptCheckedAt TimestampString(3)?
    createdAt        TimestampString(3)                @default(now())
    updatedAt        temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    dispatch         PushDispatch                @relation(fields: [dispatchId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushDeliveryAttempt_dispatchId_fkey", index: false)
    pushToken        PushToken                   @relation(fields: [pushTokenId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushDeliveryAttempt_pushTokenId_fkey", index: false)

    @@unique([dispatchId, pushTokenId], map: "PushDeliveryAttempt_dispatchId_pushTokenId_key")
    @@unique([expoTicketId], map: "PushDeliveryAttempt_expoTicketId_key")
    @@index([status, createdAt], map: "PushDeliveryAttempt_status_createdAt_idx")
  }

  model PushDispatchOutbox {
    dispatchId      Int                               @id(map: "PushDispatchOutbox_pkey")
    deliveryMode    pg.enum(PushDeliveryMode)
    force           Boolean                           @default(false)
    status          pg.enum(PushDispatchOutboxStatus) @default("PENDING")
    publishAttempts Int                               @default(0)
    availableAt     TimestampString(3)                      @default(now())
    lockedAt        TimestampString(3)?
    publishedAt     TimestampString(3)?
    lastError       VarChar(500)?
    createdAt       TimestampString(3)                      @default(now())
    updatedAt       temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    dispatch        PushDispatch                      @relation(fields: [dispatchId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushDispatchOutbox_dispatchId_fkey")

    @@index([status, availableAt, dispatchId], map: "PushDispatchOutbox_status_availableAt_dispatchId_idx")
    @@index([status, lockedAt], map: "PushDispatchOutbox_status_lockedAt_idx")
  }

  model PushRateLimitReservation {
    dispatchId Int
    phase      pg.enum(PushRateLimitPhase)
    userId     String
    localDate  DateString?
    reservedAt TimestampString(3)                @default(now())
    dispatch   PushDispatch                @relation(fields: [dispatchId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PushRateLimitReservation_dispatchId_fkey", index: false)

    @@id([dispatchId, phase], map: "PushRateLimitReservation_pkey")
    @@index([phase, userId, localDate, reservedAt], map: "PushRateLimitReservation_phase_userId_localDate_reservedAt_idx")
    @@index([phase, userId, reservedAt], map: "PushRateLimitReservation_phase_userId_reservedAt_idx")
  }

  model RecurringSuggestion {
    id                  Int                       @id(map: "RecurringSuggestion_pkey") @default(autoincrement())
    userId              String
    title               String
    daysOfWeek          Jsonb
    scheduledTime       String?
    confidence          Float
    reason              String
    matchedTodos        Jsonb
    status              pg.enum(SuggestionStatus) @default("PENDING")
    expiresAt           TimestampString(3)
    createdAt           TimestampString(3)              @default(now())
    updatedAt           temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    suggestedCategoryId Int?
    user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RecurringSuggestion_userId_fkey", index: false)

    @@index([userId, expiresAt], map: "RecurringSuggestion_userId_expiresAt_idx")
    @@index([userId, status], map: "RecurringSuggestion_userId_status_idx")
    @@index([userId, updatedAt], map: "RecurringSuggestion_userId_updatedAt_idx")
  }

  model ReminderNudge {
    id         Int           @id(map: "ReminderNudge_pkey") @default(autoincrement())
    senderId   String
    receiverId String
    message    VarChar(200)?
    createdAt  TimestampString(3)  @default(now())
    receiver   User          @relation(name: "ReminderNudge_receiverId_fkey", fields: [receiverId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ReminderNudge_receiverId_fkey", index: false)
    sender     User          @relation(name: "ReminderNudge_senderId_fkey", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ReminderNudge_senderId_fkey", index: false)

    @@index([receiverId, createdAt], map: "ReminderNudge_receiverId_createdAt_idx")
    @@index([senderId, receiverId, createdAt], map: "ReminderNudge_senderId_receiverId_createdAt_idx")
  }

  model RetentionExperimentAssignment {
    id                        String                              @id(map: "RetentionExperimentAssignment_pkey")
    userId                    String
    experimentKey             VarChar(100)
    variant                   pg.enum(RetentionExperimentVariant)
    assignedAt                TimestampString(3)                        @default(now())
    startedAt                 TimestampString(3)?
    result RetentionExperimentResult?
    stages RetentionExperimentStage[]
    user                      User                                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RetentionExperimentAssignment_userId_fkey", index: false)

    @@index([experimentKey, variant, startedAt], map: "RetentionExperimentAssignment_experimentKey_variant_startedAt_i")
    @@unique([userId, experimentKey], map: "RetentionExperimentAssignment_userId_experimentKey_key")
  }

  model RetentionExperimentResult {
