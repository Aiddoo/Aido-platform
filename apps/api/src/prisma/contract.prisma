  model TodoComment {
    id                 String            @id(map: "TodoComment_pkey")
    todoId             Int
    authorId           String
    clientRequestId    Uuid
    content            VarChar(500)?
    likeCount          Int               @default(0)
    replyCount         Int               @default(0)
    deletedAt          TimestampString(3)?
    editedAt           TimestampString(3)?
    createdAt          TimestampString(3)      @default(now())
    updatedAt          temporal.timestampString(precision: 3, onCreate: now, onUpdate: now)
    parentId           String?
    rootId             String?
    path               String[]          @default([]) @noCheck(elementNotNull)
    depth              Int               @default(0)
    requestFingerprint Char(64)?
    likes   TodoCommentLike[]
    author             User              @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "TodoComment_authorId_fkey", index: false)
    parent             TodoComment?      @relation(name: "TodoComment_parentId_fkey", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TodoComment_parentId_fkey", index: false)
    children       TodoComment[]     @relation(name: "TodoComment_parentId_fkey")
    todo               Todo              @relation(fields: [todoId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TodoComment_todoId_fkey", index: false)

    @@unique([authorId, clientRequestId], map: "TodoComment_authorId_clientRequestId_key")
    @@index([todoId, parentId, createdAt, id], map: "TodoComment_todoId_parentId_createdAt_id_idx")
    @@index([todoId, parentId, likeCount, replyCount, createdAt, id], map: "TodoComment_todoId_parentId_likeCount_replyCount_createdAt__idx")
    @@index([todoId, rootId], map: "TodoComment_todoId_rootId_idx")
