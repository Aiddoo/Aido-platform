// =============================================================================
// Prisma Schema - Aido Todo App
// =============================================================================
// Prisma 7+ 설정: prisma-client 사용, output 필수 명시

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// 인증 - 사용자
// =============================================================================

model User {
  id    String @id @default(cuid())
  email String @unique @db.VarChar(255)

  // 사용자 태그 (8자리 영숫자, 예: "ABC12DEF") - 해시태그처럼 다른 사용자가 검색할 수 있는 고유 식별자
  userTag String @unique @db.VarChar(8)

  // 역할 및 상태
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING_VERIFY)
  emailVerifiedAt DateTime?

  // 2FA (TODO)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? @db.VarChar(255)

  // 구독
  subscriptionStatus    SubscriptionStatus @default(FREE)
  subscriptionExpiresAt DateTime?
  revenueCatUserId      String?            @unique @db.VarChar(255)

  // AI 사용량 추적
  aiUsageCount   Int      @default(0) // 일일 AI 사용 횟수
  aiUsageResetAt DateTime @default(now()) // 마지막 리셋 시점 (일일 리셋 기준)

  // 타임스탬프
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Soft Delete
  deletedAt DateTime?

  // 관계: 1:1 분리 모델
  profile    UserProfile?
  preference UserPreference?
  consent    UserConsent?

  // 관계: 인증
  accounts      Account[]
  sessions      Session[]
  securityLogs  SecurityLog[]
  verifications Verification[]

  // 관계: Todo 앱
  pushTokens         PushToken[]
  todos              Todo[]
  todoCategories     TodoCategory[]
  following          Follow[]            @relation("user_following")
  followers          Follow[]            @relation("user_followers")
  sentNudges         Nudge[]             @relation("nudge_sender")
  receivedNudges     Nudge[]             @relation("nudge_receiver")
  sentCheers         Cheer[]             @relation("cheer_sender")
  receivedCheers     Cheer[]             @relation("cheer_receiver")
  dailyCompletions   DailyCompletion[]
  notifications      Notification[]
  weeklyAchievements WeeklyAchievement[]
  subscriptions      Subscription[]

  // 관계: AI
  aiReports            AiReport[]
  recurringSuggestions RecurringSuggestion[]

  @@index([status])
  @@index([subscriptionStatus])
  @@index([deletedAt])
  @@index([status, deletedAt, lastLoginAt]) // Admin 7/30일 필터
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  PENDING_VERIFY
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  EXPIRED
  CANCELLED
}

// =============================================================================
// 사용자 - 프로필
// =============================================================================

model UserProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  name         String? @db.VarChar(100)
  profileImage String? @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// 사용자 - 설정
// =============================================================================

model UserPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  pushEnabled         Boolean @default(false) // 푸시 알림 전체 on/off
  nightPushEnabled    Boolean @default(false) // 야간 푸시 동의 (21:00-08:00)
  timezone            String  @default("UTC") @db.VarChar(50) // IANA timezone (e.g. "Asia/Seoul")
  morningReminderHour   Int     @default(8) // 0-11, 사용자 로컬 시간 기준 아침 리마인더
  morningReminderMinute Int     @default(0) // 0-59
  eveningReminderHour   Int     @default(18) // 12-23, 사용자 로컬 시간 기준 저녁 리마인더
  eveningReminderMinute Int     @default(0) // 0-59

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pushEnabled, timezone]) // 타임존별 활성 사용자 스캔
  @@index([pushEnabled, timezone, morningReminderHour, morningReminderMinute]) // 아침 리마인더 스윕
  @@index([pushEnabled, timezone, eveningReminderHour, eveningReminderMinute]) // 저녁 리마인더 스윕
}

// =============================================================================
// 사용자 - 약관 동의
// =============================================================================

model UserConsent {
  id                 String    @id @default(cuid())
  userId             String    @unique
  termsAgreedAt      DateTime? // 서비스 이용약관 동의 시점
  privacyAgreedAt    DateTime? // 개인정보처리방침 동의 시점
  agreedTermsVersion String?   @db.VarChar(20) // 동의한 약관 버전 (예: "1.0.0")
  marketingAgreedAt  DateTime? // 마케팅 수신 동의 시점 (null = 미동의/철회)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// 인증 - 계정 (OAuth / Credential)
// =============================================================================

model Account {
  id                Int             @id @default(autoincrement())
  userId            String
  provider          AccountProvider
  providerAccountId String          @db.VarChar(255) // OAuth: 제공자 ID, Credential: "local"

  // Credential 전용
  password String? @db.VarChar(128) // Argon2id 해시

  // OAuth 전용
  accessToken          String? // 암호화 저장
  refreshToken         String? // 암호화 저장
  accessTokenExpiresAt DateTime?
  scope                String?   @db.VarChar(500)

  // 타임스탬프
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

enum AccountProvider {
  CREDENTIAL
  KAKAO
  APPLE
  GOOGLE
  NAVER
}

// =============================================================================
// 인증 - 세션
// =============================================================================

model Session {
  id     String @id @default(cuid())
  userId String

  // Refresh Token
  refreshTokenHash String @unique @db.VarChar(64) // SHA-256 해시

  // 토큰 로테이션
  tokenFamily       String  @db.VarChar(36) // 세션 계열 식별자 (UUID)
  tokenVersion      Int     @default(1)
  previousTokenHash String? @db.VarChar(64) // 이전 토큰 (재사용 감지)

  // 디바이스
  deviceFingerprint String @db.VarChar(64) // User-Agent + IP 해시
  userAgent         String @db.VarChar(500)
  ipAddress         String @db.VarChar(45) // IPv6 max

  // 만료
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(200)

  // 타임스탬프
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
}

// =============================================================================
// 인증 - 로그인 시도
// =============================================================================

model LoginAttempt {
  id            Int              @id @default(autoincrement())
  email         String           @db.VarChar(255)
  provider      AccountProvider? // CREDENTIAL, KAKAO, APPLE, GOOGLE, NAVER (null = legacy)
  ipAddress     String           @db.VarChar(45)
  userAgent     String           @db.VarChar(500)
  success       Boolean
  failureReason String?          @db.VarChar(100) // INVALID_PASSWORD, USER_NOT_FOUND, RATE_LIMITED

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([provider, createdAt]) // Provider별 분석용
  @@index([createdAt]) // 정리 배치용 (30일 보관)
}

// =============================================================================
// 인증 - 보안 로그
// =============================================================================

model SecurityLog {
  id        Int           @id @default(autoincrement())
  userId    String?
  event     SecurityEvent
  ipAddress String        @db.VarChar(45)
  userAgent String        @db.VarChar(500)
  metadata  Json?

  createdAt DateTime @default(now())

  // 관계
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([ipAddress, createdAt])
}

enum SecurityEvent {
  // 인증
  REGISTRATION
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  TOKEN_REFRESH
  TOKEN_REVOKED

  // 계정
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  EMAIL_VERIFIED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED

  // 보안
  SUSPICIOUS_ACTIVITY
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SESSION_REVOKED
  SESSION_REVOKED_ALL

  // OAuth
  OAUTH_LINKED
  OAUTH_UNLINKED
  OAUTH_AUTO_LINKED // 소셜 계정 자동 연동 (신뢰된 Provider)
  OAUTH_LINK_REQUIRED // 소셜 계정 연동 필요 (이메일 충돌)

  // 계정 삭제
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_HARD_DELETED
  ACCOUNT_RESTORED

  // 비밀번호 설정
  PASSWORD_SETUP
}

// =============================================================================
// 인증 - 이메일 인증 / 비밀번호 재설정
// =============================================================================

model Verification {
  id        Int              @id @default(autoincrement())
  userId    String
  type      VerificationType
  token     String           @unique @db.VarChar(64) // SHA-256 해시
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int              @default(0) // 시도 횟수 (브루트포스 보호)

  createdAt DateTime @default(now())

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
  PASSWORD_SETUP
}

// =============================================================================
// 인증 - OAuth 상태 (CSRF/PKCE/교환 코드)
// =============================================================================
// 1단계: OAuth 시작 시 state, codeVerifier 저장 (CSRF/PKCE)
// 2단계: 콜백 성공 시 exchangeCode, tokens 저장
// 3단계: 앱에서 /exchange 호출 시 코드 검증 후 삭제

model OAuthState {
  id               Int             @id @default(autoincrement())
  state            String          @unique @db.VarChar(64) // CSRF 토큰
  codeVerifier     String?         @db.VarChar(128) // PKCE
  provider         AccountProvider
  redirectUri      String          @db.VarChar(500)
  mode             String?         @db.VarChar(10) // 'login' | 'link' (null = login)
  initiatingUserId String?         @db.VarChar(36) // link 모드 시 요청한 사용자 ID

  // === 교환 코드 (콜백 성공 후 설정) ===
  exchangeCode String? @unique @db.VarChar(64) // 일회용 교환 코드

  // 인증 결과 (암호화 저장, 콜백 성공 후 설정)
  accessToken  String? @db.VarChar(1000)
  refreshToken String? @db.VarChar(1000)

  // 사용자 정보 (콜백 성공 후 설정)
  userId       String? @db.VarChar(255)
  userName     String? @db.VarChar(100)
  profileImage String? @db.VarChar(500)
  accountRestored Boolean? // 계정 복구 여부 (탈퇴 유예 기간 내 재로그인)

  // 요청 메타데이터
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  // 만료 및 상태
  expiresAt   DateTime
  exchangedAt DateTime? // 교환 완료 시점 (null = 미사용)

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// =============================================================================
// Todo 앱 - 카테고리
// =============================================================================

model TodoCategory {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7) // HEX (#FF6B43)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos Todo[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

// =============================================================================
// Todo 앱 - 할 일
// =============================================================================

model Todo {
  id     Int    @id @default(autoincrement())
  userId String

  // 내용
  title   String  @db.VarChar(200)
  content String? @db.VarChar(5000)

  // 카테고리 (필수)
  categoryId Int
  category   TodoCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // 순서
  sortOrder Int @default(0)

  // 완료
  completed   Boolean   @default(false)
  completedAt DateTime?

  // 날짜 (기간 지원)
  startDate     DateTime  @db.Date // 시작일
  endDate       DateTime? @db.Date // 종료일 (null = 단일 날짜)
  scheduledTime DateTime? @db.Timestamptz(3) // 예정 시각 (UTC, 시간 이벤트 전용)
  isAllDay      Boolean   @default(true)

  // 가시성
  visibility TodoVisibility @default(PUBLIC)

  // 반복 생성 그룹 (null = 단일 생성)
  recurrenceGroupId String? @db.VarChar(36)

  // 타임스탬프
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nudges Nudge[]

  @@index([userId, startDate, endDate])
  @@index([userId, completed, startDate])
  @@index([userId, categoryId])
  @@index([userId, sortOrder])
  @@index([completed, scheduledTime]) // 리마인더 대상 조회
  @@index([recurrenceGroupId])
}

enum TodoVisibility {
  PUBLIC // 친구 공개
  PRIVATE // 나만 보기
}

// =============================================================================
// Todo 앱 - 친구 요청/팔로우
// =============================================================================
// 친구 요청 시스템: A가 B에게 요청 → B가 수락해야 친구 성립 (양방향)
// PENDING: 친구 요청 대기 중
// ACCEPTED: 친구 관계 수락됨

enum FollowStatus {
  PENDING // 친구 요청 대기 중
  ACCEPTED // 수락됨 (친구)
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String // 요청 보낸 사람
  followingId String // 요청 받은 사람
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  follower  User @relation("user_following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("user_followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, status])
  @@index([followingId, status])
}

// =============================================================================
// Todo 앱 - 콕 찌르기 (Nudge)
// =============================================================================
// 친구에게 "잊지 마!" 하고 살짝 찔러주는 기능
// 제한 규칙 (비즈니스 로직에서 처리):
// - FREE 사용자: 3회/일
// - ACTIVE 구독자: 무제한
// - 같은 할 일 재찌르기: 24시간 쿨다운

model Nudge {
  id         Int       @id @default(autoincrement())
  senderId   String
  receiverId String
  todoId     Int
  message    String?   @db.VarChar(200) // 응원 메시지 (선택)
  createdAt  DateTime  @default(now())
  readAt     DateTime? // 확인 시각

  sender   User @relation("nudge_sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("nudge_receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  todo     Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([receiverId, createdAt]) // 받은 콕 찌름 목록 조회
  @@index([senderId, createdAt]) // 보낸 콕 찌름 목록 조회 (일일 제한 체크용)
  @@index([todoId]) // 특정 할 일에 대한 콕 찌름 조회
  @@index([senderId, todoId, createdAt]) // 같은 할 일 재찌르기 쿨다운 체크
}

// =============================================================================
// Todo 앱 - 응원 (Cheer)
// =============================================================================
// 친구가 할일을 완료했을 때 축하 메시지를 보내는 기능
// 제한 규칙 (비즈니스 로직에서 처리):
// - FREE 사용자: 3회/일
// - ACTIVE 구독자: 무제한
// - 같은 사용자 재응원: 24시간 쿨다운

model Cheer {
  id         Int       @id @default(autoincrement())
  senderId   String
  receiverId String
  message    String?   @db.VarChar(200) // 응원 메시지 (선택)
  createdAt  DateTime  @default(now())
  readAt     DateTime? // 확인 시각

  sender   User @relation("cheer_sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("cheer_receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, createdAt]) // 받은 응원 목록 조회
  @@index([senderId, createdAt]) // 보낸 응원 목록 조회 (일일 제한 체크용)
  @@index([senderId, receiverId, createdAt]) // 같은 사용자 재응원 쿨다운 체크
}

// =============================================================================
// Todo 앱 - 일일 완료 (물고기 표시)
// =============================================================================

model DailyCompletion {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date // 완료 날짜
  totalTodos     Int // 해당 날짜 총 Todo 수
  completedTodos Int // 완료한 Todo 수
  achievedAt     DateTime // 100% 달성 시점
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // 사용자당 날짜별 1개
}

// =============================================================================
// Todo 앱 - 푸시 토큰
// =============================================================================

model PushToken {
  id       Int      @id @default(autoincrement())
  userId   String
  token    String   @unique @db.VarChar(255) // Expo Push Token
  deviceId String   @db.VarChar(255) // 기기 식별자
  platform Platform
  isActive Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
}

enum Platform {
  IOS
  ANDROID
}

// =============================================================================
// Todo 앱 - 알림
// =============================================================================

model Notification {
  id     Int              @id @default(autoincrement())
  userId String
  type   NotificationType
  title  String           @db.VarChar(200)
  body   String           @db.VarChar(500)
  isRead Boolean          @default(false)

  // === 참조 ID (타입 안전성, 쿼리 성능) ===
  todoId   Int? // Todo 관련 알림
  friendId String? // 친구 관련 알림
  nudgeId  Int? // Nudge 관련 알림
  cheerId  Int? // Cheer 관련 알림

  // === 중복 방지용 날짜 ===
  notificationDate DateTime? @db.Date // 사용자 로컬 날짜 (DAILY_COMPLETE, FRIEND_COMPLETED 중복 방지)

  // === 메타데이터 (확장용) ===
  metadata Json? // { externalUrl?: string, ... }

  createdAt DateTime  @default(now())
  readAt    DateTime?

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 중복 방지: PostgreSQL partial unique index (migration 참고)
  // - Notification_daily_dedup: (userId, type, notificationDate) WHERE friendId IS NULL
  // - Notification_friend_dedup: (userId, type, friendId, notificationDate) WHERE friendId IS NOT NULL
  // - Notification_todo_reminder_dedup: (todoId, type, metadata.stage) WHERE type = TODO_REMINDER
  @@index([userId, isRead, createdAt])
  @@index([userId, type])
  @@index([userId, type, notificationDate]) // 리마인더/일일완료 중복 방지 쿼리
  @@index([createdAt]) // 정리 배치용 (90일 보관)
  @@index([todoId, type, createdAt]) // TODO_REMINDER 단계별 중복 체크
}

enum NotificationType {
  // 팔로우
  FOLLOW_NEW // 새 팔로워 알림
  FOLLOW_ACCEPTED // 친구 수락 (맞팔로우)

  // 콕 찌르기
  NUDGE_RECEIVED // 콕 찌르기 받음

  // 응원
  CHEER_RECEIVED // 응원 받음

  // 일일 완료
  DAILY_COMPLETE // 일일 완료
  FRIEND_COMPLETED // 친구 할일 완료

  // Todo
  TODO_REMINDER
  TODO_SHARED

  // 스케줄 리마인더
  MORNING_REMINDER // 아침 알림
  EVENING_REMINDER // 저녁 알림

  // 달성
  WEEKLY_ACHIEVEMENT

  // AI
  WEEKLY_REPORT // 주간 AI 리포트
  MONTHLY_REPORT // 월간 AI 리포트
  AI_SUGGESTION // AI 반복 제안

  // 시스템
  SYSTEM_NOTICE

  // 관리자 발송
  ADMIN_BROADCAST // 관리자 전체/조건부 알림
  ADMIN_TARGETED // 관리자 특정 사용자 알림
}

// =============================================================================
// Todo 앱 - 주간 달성 배지
// =============================================================================

model WeeklyAchievement {
  id     Int    @id @default(autoincrement())
  userId String

  // ISO Week
  year Int // 연도
  week Int // 주차 (1-53)

  // 달성 정보
  totalTodos     Int // 총 Todo 수
  completedTodos Int // 완료 수
  achievedAt     DateTime // 달성 시점

  createdAt DateTime @default(now())

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, week])
  @@index([userId, year])
  @@index([year, week]) // 주간 랭킹 조회용
}

// =============================================================================
// Todo 앱 - 구독
// =============================================================================

model Subscription {
  id     Int    @id @default(autoincrement())
  userId String

  // RevenueCat
  revenueCatId String @unique @db.VarChar(255) // 거래 ID
  productId    String @db.VarChar(100) // 상품 ID

  // 상태
  status SubscriptionStatus

  // 기간
  startedAt   DateTime
  expiresAt   DateTime
  cancelledAt DateTime?

  // 웹훅 이벤트 중복 방지
  lastProcessedEventId String? @db.VarChar(255)

  // 데이터 보관
  dataRetentionUntil DateTime? // 해지 후 보관 기한

  // Soft Delete
  deletedAt DateTime?

  // 타임스탬프
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, expiresAt])
  @@index([deletedAt])
}

// =============================================================================
// AI - 리포트
// =============================================================================

enum ReportType {
  WEEKLY
  MONTHLY
}

model AiReport {
  id     Int        @id @default(autoincrement())
  userId String
  type   ReportType

  // 기간 식별
  year   Int
  period Int // WEEKLY: 주차(1-53), MONTHLY: 월(1-12)

  // 통계 데이터
  stats             Json
  categoryBreakdown Json
  dayPatterns       Json
  timePatterns      Json

  // AI 분석 결과
  aiSummary String  @db.Text
  aiTips    Json

  // 상태
  hasActivity Boolean
  generatedAt DateTime

  // 타임스탬프
  createdAt DateTime @default(now())

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, year, period])
  @@index([userId, type])
}

// =============================================================================
// AI - 반복 제안
// =============================================================================

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model RecurringSuggestion {
  id     Int    @id @default(autoincrement())
  userId String

  // 제안 내용
  title         String
  daysOfWeek    Json // DayOfWeek[] (예: ["MON", "WED", "FRI"])
  scheduledTime String? // HH:mm 형식
  confidence    Float
  reason        String

  // 매칭된 기존 할 일
  matchedTodos Json // 참고한 Todo 정보

  // 상태
  status    SuggestionStatus @default(PENDING)
  expiresAt DateTime

  // 타임스탬프
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
