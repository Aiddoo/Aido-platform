{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      // 테스트 진입점(spec·setup·globalSetup)은 vitest 플러그인이 vitest.config.ts에서 읽는다
      "entry": [
        "src/bootstrap.ts",
        // alert-catalog.spec이 *.alerts.ts의 export를 모두 읽어 문서 표와 맞춘다
        "src/**/*.alerts.ts",
        "scripts/**/*.{ts,mjs,cjs}",
        "test/dev-fixtures/*.ts",
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.{ts,mjs,cjs}"],
      // pino transport가 이름 문자열로 불러 import가 없다(platform/logging/logger.options.ts)
      "ignoreDependencies": ["pino-pretty"],
    },
  },
}
