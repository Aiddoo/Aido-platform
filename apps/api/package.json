{
  "name": "@aido/server",
  "version": "1.15.3",
  "private": true,
  "description": "Aido API Server",
  "license": "MIT",
  "author": "dydals3440",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#api/*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    },
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "ai:eval": "tsx --tsconfig tsconfig.json scripts/ai-eval/run.ts",
    "build": "nest build",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm --filter @aido/database-migrate db:deploy",
    "db:studio": "drizzle-kit studio",
    "dev": "nest start --watch",
    "fixture:todo-comments": "NODE_ENV=development DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aido API_BASE_URL=http://localhost:8080 tsx --tsconfig test/dev-fixtures/tsconfig.json --env-file=../../.env.docker.dev test/dev-fixtures/todo-comment-development-fixture.ts",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "lint": "oxlint src test",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:fix": "oxlint src test --fix",
    "start": "nest start",
    "start:prod": "NODE_ENV=production node ./dist/src/bootstrap.js",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project e2e test/e2e/openapi-contract.e2e-spec.ts",
    "test:cov": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:diagnose": "vitest run --project e2e --no-file-parallelism --reporter=verbose",
    "test:integration": "vitest run --project integration",
    "test:performance": "vitest run --project performance",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@aido/api": "workspace:*",
    "@nestjs-cls/transactional": "catalog:nest12",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "catalog:drizzle1",
    "@nestjs/common": "catalog:nest12",
    "@nestjs/config": "catalog:nest12",
    "@nestjs/core": "catalog:nest12",
    "@nestjs/drizzle": "catalog:nest12",
    "@nestjs/event-emitter": "catalog:nest12",
    "@nestjs/http-client": "catalog:nest12",
    "@nestjs/i18n": "catalog:nest12",
    "@nestjs/jwt": "catalog:nest12",
    "@nestjs/mail": "catalog:nest12",
    "@nestjs/platform-express": "catalog:nest12",
    "@nestjs/swagger": "catalog:nest12",
    "@nestjs/terminus": "catalog:nest12",
    "@nestjs/throttler": "catalog:nest12",
    "@photostructure/tz-lookup": "catalog:",
    "@sentry/nestjs": "catalog:",
    "ai": "catalog:",
    "argon2": "catalog:",
    "bowser": "catalog:",
    "cockatiel": "catalog:",
    "countries-and-timezones": "catalog:",
    "drizzle-orm": "catalog:drizzle1",
    "es-hangul": "2.4.0",
    "es-toolkit": "catalog:",
    "expo-server-sdk": "catalog:",
    "express": "catalog:",
    "google-auth-library": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "lru-cache": "catalog:",
    "nestjs-cls": "catalog:nest12",
    "nestjs-pino": "catalog:nest12",
    "ngeohash": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aido/test-config": "workspace:*",
    "@aido/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:nest12",
    "@nestjs/schematics": "catalog:nest12",
    "@nestjs/testing": "catalog:nest12",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/express": "5.0.6",
    "@types/ngeohash": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-kit": "catalog:drizzle1",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
