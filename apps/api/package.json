{
  "name": "@aido/server",
  "version": "1.0.0",
  "private": true,
  "description": "Aido API Server",
  "license": "MIT",
  "author": "dydals3440",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#api/*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    },
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "db:deploy": "sh scripts/migrate.sh",
    "db:generate": "turbo run contract:emit --filter=@aido/server",
    "db:migrate": "prisma db migrate",
    "dev": "nest start --watch",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "fixture:todo-comments": "NODE_ENV=development DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aido API_BASE_URL=http://localhost:8080 tsx --tsconfig test/dev-fixtures/tsconfig.json --env-file=../../.env.docker.dev test/dev-fixtures/todo-comment-development-fixture.ts",
    "lint": "oxlint src test",
    "lint:fix": "oxlint src test --fix",
    "start": "nest start",
    "start:prod": "NODE_ENV=production node ./dist/src/bootstrap.js",
    "test": "vitest run --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:coverage": "pnpm test:cov",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:diagnose": "vitest run --project e2e --no-file-parallelism --reporter=verbose",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "test:performance": "vitest run --project performance",
    "db:plan": "prisma migration plan",
    "db:verify": "prisma db verify"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.88",
    "@aido/api": "workspace:*",
    "@nestjs-cls/transactional": "catalog:nest12",
    "@nestjs/common": "catalog:nest12",
    "@nestjs/config": "catalog:nest12",
    "@nestjs/core": "catalog:nest12",
    "@nestjs/event-emitter": "catalog:nest12",
    "@nestjs/http-client": "0.0.1",
    "@nestjs/jwt": "catalog:nest12",
    "@nestjs/passport": "catalog:nest12",
    "@nestjs/platform-express": "catalog:nest12",
    "@nestjs/swagger": "catalog:nest12",
    "@nestjs/terminus": "catalog:nest12",
    "@nestjs/throttler": "catalog:nest12",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "@sentry/nestjs": "11.4.0",
    "ai": "7.0.128",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "dayjs": "catalog:",
    "es-hangul": "2.4.0",
    "es-toolkit": "catalog:",
    "expo-server-sdk": "7.2.0",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nestjs-cls": "catalog:nest12",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pg-boss": "catalog:",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.32.0",
    "rxjs": "7.8.2",
    "sql-template-tag": "5.2.1",
    "temporal-polyfill": "1.0.5",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aido/typescript-config": "workspace:*",
    "@aido/vitest-config": "workspace:*",
    "@nestjs/cli": "catalog:nest12",
    "@nestjs/schematics": "catalog:nest12",
    "@nestjs/testing": "catalog:nest12",
    "@prisma/cli-engine": "0.6.2",
    "@suites/di.nestjs": "3.1.0",
    "@suites/doubles.vitest": "3.1.0",
    "@suites/unit": "3.1.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/ioredis-mock": "8.2.8",
    "@types/node": "catalog:",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "ioredis-mock": "8.13.1",
    "prisma": "8.0.0-rc.20",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:",
    "vitest-mock-extended": "5.1.1"
  }
}
