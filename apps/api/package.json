{
	"name": "@aido/api",
	"version": "1.0.0",
	"private": true,
	"description": "Aido API Server",
	"license": "MIT",
	"author": "dydals3440",
	"scripts": {
		"build": "nest build",
		"clean": "rm -rf dist coverage *.tsbuildinfo",
		"db:deploy": "prisma migrate deploy",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:studio": "prisma studio --config ./prisma.config.ts",
		"dev": "nest start --watch",
		"format": "oxfmt src test",
		"format:check": "oxfmt --check src test",
		"fixture:todo-comments": "NODE_ENV=development DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aido API_BASE_URL=http://localhost:8080 TS_NODE_PROJECT=test/dev-fixtures/tsconfig.json node --env-file=../../.env.docker.dev -r ts-node/register -r tsconfig-paths/register test/dev-fixtures/todo-comment-development-fixture.ts",
		"lint": "oxlint src test",
		"lint:fix": "oxlint src test --fix",
		"start": "nest start",
		"start:prod": "NODE_ENV=production node dist/src/main",
		"test": "jest",
		"test:cov": "jest --coverage",
		"test:coverage": "jest --coverage",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"test:e2e:diagnose": "jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles --randomize --showSeed",
		"test:integration": "jest --config ./test/jest-integration.json",
		"test:watch": "jest --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/google": "^4.0.58",
		"@aido/errors": "workspace:*",
