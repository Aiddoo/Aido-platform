# Aido API 테스트 env (NODE_ENV=test). 외부 서비스는 모두 Fake로 바꾸므로 키를 두지 않는다.
# DB 주소는 검증만 통과시키고 실제 연결은 Testcontainers가 덮는다(test/e2e/helpers/e2e-app-factory.ts).

# --- App ---
NODE_ENV=test
PORT=8080

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aido_test"

# --- JWT ---
JWT_SECRET=test-jwt-secret-key-minimum-32-characters-long-for-e2e
JWT_REFRESH_SECRET=test-refresh-secret-key-minimum-32-characters-long-e2e
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Email ---
# FakeEmailService가 대체. 큐·어댑터를 거치는 테스트도 실제로 보내지 않는다
EMAIL_PROVIDER=log
ADMIN_NOTIFIER_PROVIDER=log
EMAIL_FROM="noreply@test.example.com"
EMAIL_FROM_NAME="Aido Test"

# --- Security ---
TOKEN_ENCRYPTION_KEY=test-token-encryption-key-minimum-32-characters-long

# --- OAuth ---
# FakeOAuthTokenVerifierService가 대체 (실제 OAuth 호출 없음)
GOOGLE_CLIENT_ID="test-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="test-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8080/v1/auth/google/callback"
APPLE_CLIENT_ID="com.test.example.app"
KAKAO_CLIENT_ID="test-kakao-client-id"
KAKAO_CLIENT_SECRET="test-kakao-client-secret"
KAKAO_CALLBACK_URL="http://localhost:8080/v1/auth/kakao/callback"
NAVER_CLIENT_ID="test-naver-client-id"
NAVER_CLIENT_SECRET="test-naver-client-secret"
NAVER_CALLBACK_URL="http://localhost:8080/v1/auth/naver/callback"

# --- Cache ---
CACHE_TYPE=memory
PUSH_RATE_LIMIT_BACKEND=memory

# --- Logger ---
LOG_LEVEL=silent
