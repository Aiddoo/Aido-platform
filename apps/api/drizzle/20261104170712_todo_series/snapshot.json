      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "TodoSeries",
        "name": "TodoSeries_repeatMonthDay_check",
        "value": "(\"repeatFrequency\" = 'MONTHLY') = (\"repeatMonthDay\" IS NOT NULL) AND (\"repeatMonthDay\" IS NULL OR \"repeatMonthDay\" BETWEEN 1 AND 31)",
        "entityType": "checks"
      }
    },
