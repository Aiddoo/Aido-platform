      "op": "create",
      "row": {
        "schema": "public",
        "table": "TodoSeries",
        "name": "TodoSeries_repeatCount_check",
        "value": "\"repeatCount\" IS NULL OR \"repeatCount\" BETWEEN 1 AND 365",
        "entityType": "checks"
      }
    },
