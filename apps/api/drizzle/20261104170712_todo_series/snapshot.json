        "schema": "public",
        "table": "TodoSeries",
        "name": "TodoSeries_repeatWeekdays_check",
        "value": "(\"repeatFrequency\" = 'WEEKLY') = (\"repeatWeekdays\" IS NOT NULL AND cardinality(\"repeatWeekdays\") > 0) AND (\"repeatWeekdays\" IS NULL OR \"repeatWeekdays\" <@ ARRAY['MON','TUE','WED','THU','FRI','SAT','SUN']::text[])",
