{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "bootstrap",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": true,
    "assets": [
      { "include": "i18n/**/*.json", "watchAssets": true },
      {
        "include": "modules/notification/email/infrastructure/templates/**/*.{html,txt}",
        "watchAssets": true
      }
    ]
  }
}
