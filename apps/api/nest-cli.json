{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "bootstrap",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": { "extensions": [".js", ".ts", ".tsx"] }
    },
    "typeCheck": true,
    "assets": [{ "include": "i18n/**/*.json", "watchAssets": true }]
  }
}
