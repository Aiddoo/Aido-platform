{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"extends": ["../../biome.json"],
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"linter": {
		"rules": {
			"style": {
				"useImportType": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noThisInStatic": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.spec.ts", "**/*.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/modules/**/domain/**",
				"**/modules/**/application/**",
				"**/modules/**/infrastructure/**",
				"**/common/domain/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "error"
					}
				}
			}
		}
	]
}
