{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "node"],
  "jsPlugins": ["./tooling/oxlint-plugin-aido/index.mjs"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["**/*.generated.*", "**/dist/**", "**/build/**", "**/coverage/**"],
  "rules": {
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/curly": ["error", "all"],
    "eslint/no-unused-vars": "error",
    "eslint/prefer-const": "error",
    "import/no-cycle": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": true,
        "ts-ignore": true,
        "ts-nocheck": true
      }
    ],
    "typescript/no-extraneous-class": [
      "error",
      {
        "allowWithDecorator": true
      }
    ],
    "unicorn/no-static-only-class": "error"
  },
  "overrides": [
    {
      "files": ["apps/api/**/*.{ts,tsx}"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": [
        "apps/api/src/modules/notification/email-messages/infrastructure/templates/**/*.tsx"
      ],
      "plugins": ["react"]
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}", "apps/api/test/**/*.ts", "apps/api/scripts/**/*.ts"],
      "rules": {
        "aido/no-member-accessibility": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nestjs/common",
                "importNames": ["forwardRef"],
                "message": "forwardRef 순환 의존. 좁은 Port를 public으로 열고 반대 방향은 이벤트로 바꾼다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/shared/domain/**/*.ts"],
      "rules": {
        "aido/no-member-accessibility": ["error", { "allowProtected": true }]
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}", "packages/*/src/**/*.{ts,tsx}"],
      "excludeFiles": ["**/*.d.ts", "**/generated/**"],
      "rules": {
        "aido/no-strict-nullish": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}", "packages/*/src/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "z",
            "property": "nativeEnum",
            "message": "Zod 4에서 z.nativeEnum은 옛 문법입니다. z.enum을 씁니다."
          },
          {
            "property": "passthrough",
            "message": "Zod 4에서 .passthrough()는 옛 문법입니다. z.looseObject를 씁니다."
          },
          {
            "property": "strict",
            "message": "Zod 4에서 .strict()는 옛 문법입니다. z.strictObject를 씁니다."
          },
          {
            "property": "merge",
            "message": "Zod 4에서 .merge()는 옛 문법입니다. .extend(other.shape)나 펼친 shape로 합칩니다."
          },
          {
            "property": "superRefine",
            "message": "Zod 4에서 .superRefine()은 옛 문법입니다. .check()나 .refine()을 씁니다."
          },
          {
            "property": "errorMap",
            "message": "Zod 4에서 errorMap은 옛 문법입니다. error 옵션을 씁니다."
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}", "packages/*/src/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.integration-spec.ts", "**/*.test.ts"],
      "rules": {
        "aido/time-constant-unit": "error",
        "aido/no-locale-literal-comparison": "error"
      }
    },
    {
      "files": ["apps/api/src/platform/database/schema/*.ts"],
      "rules": {
        "aido/no-pg-enum-literal": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.log-events.ts"],
      "rules": {
        "aido/log-event-key": [
          "error",
          {
            "constantPattern": "LogEvent$",
            "minSegments": 3,
            "maxSegments": 5,
            "singleWordOutcome": true,
            "contextFromPath": true
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": ["apps/api/src/**/*.spec.ts"],
      "rules": {
        "aido/logger-event-constant": [
          "error",
          {
            "eventProperty": "event",
            "methods": ["log", "debug", "warn", "error", "verbose", "fatal"]
          }
        ]
      }
    },
    {
      "files": [
        "apps/api/src/**/*.{ts,tsx}",
        "apps/api/test/**/*.ts",
        "apps/api/scripts/**/*.ts",
        "packages/api/src/**/*.ts",
        "packages/api/test/**/*.ts"
      ],
      "rules": {
        "aido/no-abbreviation": "error",
        "aido/no-restating-comment": "error"
      }
    },
    {
      "files": [
        "apps/api/**/*.spec.ts",
        "apps/api/**/*.integration-spec.ts",
        "apps/api/**/*.e2e-spec.ts",
        "apps/api/**/*.performance-spec.ts",
        "packages/api/test/**/*.ts"
      ],
      "rules": {
        "aido/test-gwt-comments": "error"
      }
    },
    {
      "files": [
        "apps/api/src/**/*.use-case.spec.ts",
        "apps/api/test/fixtures/**/*.ts",
        "apps/api/test/doubles/**/*.ts"
      ],
      "rules": {
        "aido/no-vitest-mock": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": ["**/*.errors.ts", "**/*.spec.ts", "**/*.integration-spec.ts"],
      "rules": {
        "aido/no-inline-coded-exception": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": ["**/*.spec.ts", "**/*.integration-spec.ts"],
      "rules": {
        "aido/aggregate-shape": "error",
        "aido/member-order": "error",
        "aido/max-params": ["error", { "max": 3 }]
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": [
        "**/*.spec.ts",
        "**/*.integration-spec.ts",
        "**/*.messages.ts",
        "apps/api/src/platform/database/schema/**"
      ],
      "rules": {
        "max-lines": ["error", { "max": 400 }],
        "max-lines-per-function": ["error", { "max": 80 }]
      }
    },
    {
      "files": ["apps/api/src/**/*.port.ts"],
      "rules": {
        "aido/port-id-value-object": "error",
        "aido/port-return-shape": "error"
      }
    },
    {
      "files": ["apps/api/src/shared/application/ports/domain-event-publisher.port.ts"],
      "rules": {
        "aido/port-id-value-object": ["error", { "technicalIds": ["eventId"] }]
      }
    },
    {
      "files": ["apps/api/src/**/*.use-case.ts"],
      "rules": {
        "aido/use-case-single-execute": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": [
        "**/*.errors.ts",
        "apps/api/src/shared/**/*.exception.ts",
        "**/*.spec.ts",
        "**/*.integration-spec.ts"
      ],
      "rules": {
        "aido/error-class-location": "error"
      }
    },
    {
      "files": ["apps/api/src/**/application/**/*.ts", "apps/api/src/**/domain/**/*.ts"],
      "excludeFiles": [
        "**/*.errors.ts",
        "apps/api/src/shared/**/*.exception.ts",
        "**/*.spec.ts",
        "**/*.integration-spec.ts"
      ],
      "rules": {
        "aido/error-class-location": ["error", { "inlineThrow": true }]
      }
    },
    {
      "files": ["apps/api/src/**/application/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.integration-spec.ts"],
      "rules": {
        "aido/read-model-suffix": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.read-model.ts"],
      "rules": {
        "aido/read-model-suffix": ["error", { "exportSuffix": "ReadModel" }]
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": [
        "apps/api/src/modules/*/*/presentation/http/*.rate-limits.ts",
        "**/*.spec.ts",
        "**/*.integration-spec.ts"
      ],
      "rules": {
        "aido/rate-limit-location": "error"
      }
    },
    {
      "files": ["apps/api/src/modules/*/*/presentation/http/*.rate-limits.ts"],
      "rules": {
        "aido/rate-limit-location": ["error", { "definitionFile": true }]
      }
    },
    {
      "files": ["apps/api/src/modules/**/*.ts"],
      "rules": {
        "aido/no-foreign-context-table": "error"
      }
    },
    {
      "files": ["apps/api/src/**/index.ts"],
      "excludeFiles": ["apps/api/src/platform/database/schema/index.ts"],
      "rules": {
        "aido/no-barrel-file": "error"
      }
    },
    {
      "files": ["apps/api/test/**/index.ts"],
      "rules": {
        "aido/no-barrel-file": "error"
      }
    },
    {
      "files": [
        "apps/api/test/fixtures/**/*.ts",
        "apps/api/test/doubles/**/*.ts",
        "apps/api/test/e2e/helpers/**/*.ts"
      ],
      "rules": {
        "aido/no-re-export": "error"
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.e2e-spec.ts",
        "**/*.integration-spec.ts",
        "apps/api/test/**/*.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": "allow-with-description",
            "ts-ignore": true,
            "ts-nocheck": true
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": [
        "apps/api/src/platform/config/env.ts",
        "apps/api/src/**/*.config.ts",
        "**/*.spec.ts"
      ],
      "rules": {
        "node/no-process-env": "error"
      }
    },
    {
      "files": ["apps/api/**/*.{ts,tsx}", "packages/api/**/*.ts"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          {
            "case": "kebabCase",
            "multipleFileExtensions": false
          }
        ]
      }
    },
    {
      "files": ["packages/api/src/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@nestjs/|^drizzle-orm(?:/|$)|^@aido/(?:server|mobile)(?:/|$)|^node:|^pg(?:/|$)|^react-native(?:/|$)",
                "message": "공유 REST 계약은 서버·네이티브 runtime에 의존할 수 없습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/api/src/vocabulary/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@nestjs/|^drizzle-orm(?:/|$)|^@aido/(?:server|mobile)(?:/|$)|^node:|^pg(?:/|$)|^react-native(?:/|$)|^zod(?:/|$)|(?:^|/)(?:contracts|errors)(?:/|$)",
                "message": "공유 vocabulary는 runtime·Zod·REST 스키마에 의존할 수 없습니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/shared/domain/**/*.ts", "apps/api/src/shared/application/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@nestjs/|(?:^|/)(?:platform|infrastructure|presentation|modules)(?:/|$)",
                "message": "Shared Domain/Application은 framework·구현·개별 Context에 의존할 수 없습니다."
              },
              {
                "regex": "^(?:pg|pg-boss|drizzle-orm|drizzle-kit|ioredis|jose|ai|google-auth-library|expo-server-sdk)(?:/|$)|^@(?:ai-sdk|sentry)/",
                "message": "외부 I/O·vendor SDK는 Infrastructure Adapter가 소유합니다."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/shared/domain/**/*.ts", "apps/api/src/shared/application/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "typescript/consistent-type-imports": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.providers.ts"],
      "rules": {
        "eslint/object-shorthand": "error"
      }
    },
    {
      "files": ["apps/api/src/modules/*/*/domain/**/*.ts", "apps/api/src/modules/*/shared/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@nestjs/|(?:^|/)platform(?:/|$)",
                "message": "Domain은 framework·ORM·platform 구현에 의존할 수 없습니다."
              },
              {
                "regex": "(?:^|/)(?:application|infrastructure|presentation)(?:/|$)",
                "message": "Domain은 Application·Infrastructure·Presentation에 의존할 수 없습니다."
              },
              {
                "regex": "^(?:pg|pg-boss|drizzle-orm|drizzle-kit|ioredis|jose|ai|google-auth-library|expo-server-sdk)(?:/|$)|^@(?:ai-sdk|sentry)/",
                "message": "외부 I/O·vendor SDK는 Infrastructure Adapter가 소유합니다."
              },
              {
                "regex": "^@aido/api/(?:contracts|common)(?:/|$)",
                "message": "Domain·Application은 계약 타입을 쓰지 않는다. vocabulary·errors만 허용"
              }
            ]
          }
        ],
        "typescript/consistent-type-imports": "error"
      }
    },
    {
      "files": ["apps/api/src/modules/*/*/application/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@nestjs/|(?:^|/)platform(?:/|$)",
                "message": "Application은 framework·ORM·platform 구현에 의존할 수 없습니다."
              },
              {
                "regex": "(?:^|/)(?:infrastructure|presentation)(?:/|$)",
                "message": "Application은 Infrastructure·Presentation 구현에 의존할 수 없습니다."
              },
              {
                "regex": "^(?:pg|pg-boss|drizzle-orm|drizzle-kit|ioredis|jose|ai|google-auth-library|expo-server-sdk)(?:/|$)|^@(?:ai-sdk|sentry)/",
                "message": "외부 I/O·vendor SDK는 Infrastructure Adapter가 소유합니다."
              },
              {
                "regex": "^@aido/api/(?:contracts|common)(?:/|$)",
                "message": "Domain·Application은 계약 타입을 쓰지 않는다. vocabulary·errors만 허용"
              }
            ]
          }
        ],
        "typescript/consistent-type-imports": "error"
      }
    },
    {
      "files": ["apps/api/**/*.{ts,tsx}"],
      "rules": {
        "typescript/parameter-properties": [
          "error",
          {
            "prefer": "class-property"
          }
        ]
      }
    },
    {
      "files": ["apps/api/**/*.{ts,tsx}", "packages/api/**/*.ts"],
      "rules": {
        "unicorn/numeric-separators-style": [
          "error",
          {
            "number": {
              "minimumDigits": 5,
              "groupLength": 3
            },
            "hexadecimal": {
              "onlyIfContainsSeparator": true
            },
            "binary": {
              "onlyIfContainsSeparator": true
            },
            "octal": {
              "onlyIfContainsSeparator": true
            }
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}", "packages/api/src/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.integration-spec.ts", "**/*.test.ts"],
      "rules": {
        "aido/no-switch-statement": "error",
        "eslint/no-var": "error",
        "eslint/prefer-object-has-own": "error",
        "eslint/prefer-object-spread": "error",
        "unicorn/no-array-for-each": "error",
        "unicorn/no-array-reverse": "error",
        "unicorn/no-array-sort": "error",
        "unicorn/prefer-array-find": "error",
        "unicorn/prefer-array-flat": "error",
        "unicorn/prefer-array-flat-map": "error",
        "unicorn/prefer-array-some": "error",
        "unicorn/prefer-at": "error",
        "unicorn/prefer-date-now": "error",
        "unicorn/prefer-includes": "error",
        "unicorn/prefer-math-trunc": "error",
        "unicorn/prefer-modern-math-apis": "error",
        "unicorn/prefer-node-protocol": "error",
        "unicorn/prefer-object-from-entries": "error",
        "unicorn/prefer-optional-catch-binding": "error",
        "unicorn/prefer-regexp-test": "error",
        "unicorn/prefer-set-has": "error",
        "unicorn/prefer-spread": "error",
        "unicorn/prefer-string-replace-all": "error",
        "unicorn/prefer-string-slice": "error"
      }
    },
    {
      "files": ["apps/api/src/**/*.{ts,tsx}"],
      "excludeFiles": [
        "apps/api/src/**/*.public.ts",
        "apps/api/src/platform/database/schema/index.ts",
        "apps/api/src/platform/database/schema/tables.schema.ts"
      ],
      "plugins": ["oxc"],
      "rules": {
        "oxc/no-barrel-file": [
          "error",
          {
            "threshold": 0
          }
        ],
        "aido/no-re-export": "error"
      }
    },
    {
      // apps/mobile/.oxlintrc.json이 extends로 이 override를 받으면 globs는 apps/mobile 기준이라 앱 도구는 store-metadata·.maestro로 적는다
      // plugins/(Expo config plugin)는 고치면 Expo fingerprint가 바뀌어 OTA가 막히므로 스토어 빌드 층에서만 바꾼다
      "files": [
        "scripts/**/*.{js,mjs,cjs,ts}",
        "tooling/**/*.{js,mjs,cjs,mts,ts}",
        "turbo/generators/**/*.{mjs,ts}",
        "apps/api/scripts/**/*.{cjs,mjs,ts}",
        "store-metadata/**/*.mjs",
        ".maestro/**/scripts/*.{js,ts}"
      ],
      "rules": {
        "unicorn/prefer-string-replace-all": "error",
        "unicorn/prefer-spread": "error",
        "unicorn/prefer-at": "error",
        "unicorn/prefer-node-protocol": "error",
        "eslint/no-var": "error",
        "eslint/prefer-object-spread": "error",
        "unicorn/prefer-import-meta-properties": "error",
        "unicorn/no-array-for-each": "error",
        "unicorn/prefer-set-has": "error",
        "unicorn/prefer-includes": "error",
        "unicorn/prefer-array-find": "error",
        "unicorn/prefer-array-some": "error",
        "unicorn/prefer-array-flat-map": "error",
        "unicorn/prefer-object-from-entries": "error",
        "unicorn/prefer-date-now": "error",
        "unicorn/prefer-optional-catch-binding": "error",
        "eslint/prefer-object-has-own": "error",
        "aido/no-abbreviation": "error"
      }
    }
  ]
}
