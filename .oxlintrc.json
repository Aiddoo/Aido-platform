{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript"],
  "categories": {
    "correctness": "off"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/*.generated.*",
    "apps/api/prisma/generated/**",
    "apps/api/src/generated/**",
    "apps/mobile/assets/**",
    "apps/mobile/.agents/**",
    "apps/mobile/.claude/skills/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "apps/api/prisma/migrations8/snapshots/**",
    "apps/api/prisma/migrations8/**/ops.json",
    "apps/api/prisma/migrations8/**/migration.json"
  ],
  "rules": {
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-unused-vars": "error",
    "eslint/prefer-const": "error",
    "import/no-cycle": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn"
  },
  "overrides": [
    {
      "files": ["apps/api/**/*.ts"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.e2e-spec.ts",
        "**/*.integration-spec.ts",
        "apps/api/test/**/*.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["apps/mobile/index.ts"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["apps/api/src/*/domain/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@nestjs/",
                "message": "domain\uc740 NestJS\uc5d0 \uc758\uc874\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
              },
              {
                "regex": "(?:^|/)generated(?:/|$)",
                "message": "domain\uc740 \uc0dd\uc131\ub41c Prisma \ud0c0\uc785\uc5d0 \uc758\uc874\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
              },
              {
                "regex": "(?:^|/)presentation(?:/|$)",
                "message": "domain\uc740 presentation\uc5d0 \uc758\uc874\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
              },
              {
                "regex": "(?:^|/)application/ports(?:/|$)",
                "message": "domain\uc740 application port\uc5d0 \uc758\uc874\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/*/application/**/*.ts"],
      "excludeFiles": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@prisma/|(?:^|/)generated(?:/|$)",
                "message": "application\uc740 Prisma \ud0c0\uc785\uc5d0 \uc758\uc874\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
              },
              {
                "regex": "(?:^|/)infrastructure(?:/|$)",
                "message": "application\uc740 infrastructure \uad6c\ud604\uc5d0 \uc758\uc874\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
              },
              {
                "regex": "(?:^|/)presentation(?:/|$)",
                "message": "application\uc740 presentation\uc5d0 \uc758\uc874\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/api/src/*/domain/**/*.ts",
        "apps/api/src/*/application/**/*.ts",
        "apps/api/src/*/infrastructure/**/*.ts"
      ],
      "excludeFiles": [
        "apps/api/src/shared/application/**/*.ts",
        "apps/api/src/shared/infrastructure/**/*.ts",
        "**/*.spec.ts",
        "**/*.test.ts"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "error"
      }
    }
  ]
}
