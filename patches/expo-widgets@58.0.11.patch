diff --git a/android/src/main/java/expo/modules/widgets/WidgetAppLaunchIntent.kt b/android/src/main/java/expo/modules/widgets/WidgetAppLaunchIntent.kt
new file mode 100644
index 0000000000000000000000000000000000000000..388e5b246cf0f5cc57196cf1fc53a73049189abf
--- /dev/null
+++ b/android/src/main/java/expo/modules/widgets/WidgetAppLaunchIntent.kt
@@ -0,0 +1,21 @@
+package expo.modules.widgets
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+
+private val widgetAppDestinationPattern = Regex(
+  """aido(?:-dev|-preview)?://(?:feed\?date=(?:today|\d{4}-\d{2}-\d{2})(?:&action=add-todo)?|todo/[1-9]\d*)"""
+)
+
+internal fun widgetAppLaunchIntent(context: Context, destination: String?): Intent? {
+  if (destination == "__aido_widget_open_app") {
+    return context.packageManager.getLaunchIntentForPackage(context.packageName)
+  }
+  if (destination == null || !widgetAppDestinationPattern.matches(destination)) return null
+  return context.packageManager.getLaunchIntentForPackage(context.packageName)?.apply {
+    action = Intent.ACTION_VIEW
+    data = Uri.parse(destination)
+    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)
+  }
+}
