# =============================================================================
# Aido Docker 개발 환경 (.env.docker.dev)
# 사용법: cp .env.docker.dev.example .env.docker.dev
# =============================================================================

# --- App ---
NODE_ENV=development
# 배포 환경 구분 (development | staging | production). 미설정 시 NODE_ENV 기준으로 판단한다.
APP_ENV=development
# 헬스 체크 응답에 노출할 인스턴스 식별자 (선택)
# INSTANCE_ID=
PORT=8080

# --- Database ---
# 호스트명 'db'는 docker-compose.dev.yml의 서비스명
DATABASE_URL=postgresql://postgres:postgres@db:5432/aido
# 호스트 포트 (로컬 5432와 충돌 방지)
DB_PORT=5433

# --- Durable jobs (기본 개발 경로: PostgreSQL) ---
JOB_BACKEND=postgres
JOB_SCHEMA=pgboss
JOB_REDIS_DRAIN_ENABLED=false

# Redis rollback/drain 경로를 검증할 때만 사용
# REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_SECRET=dev-jwt-secret-key-minimum-32-characters-long-for-security
JWT_REFRESH_SECRET=dev-refresh-secret-key-minimum-32-characters-long-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Security ---
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-minimum-32-characters-long
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081
THROTTLE_TTL=60000
THROTTLE_LIMIT=1000

# --- OAuth: Google ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/google/web-callback

# --- OAuth: Apple ---
# APPLE_TEAM_ID=
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_CALLBACK_URL=http://localhost:8080/v1/auth/apple/callback

# --- OAuth: Kakao ---
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=http://localhost:8080/v1/auth/kakao/web-callback

# --- OAuth: Naver ---
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_CALLBACK_URL=http://localhost:8080/v1/auth/naver/web-callback

# --- Email ---
# RESEND_API_KEY=
# EMAIL_FROM=hello@your-domain.com
# EMAIL_FROM_NAME=Aido

# --- External Services ---
# GOOGLE_GENERATIVE_AI_API_KEY=
# DISCORD_SIGNUP_WEBHOOK_URL=

# --- RevenueCat ---
# RevenueCat REST API 비밀 키 (서버 측 호출용으로 예약, 현재 미사용)
# REVENUECAT_SECRET_API_KEY=
# 웹훅 서명 검증 비밀 (구독 웹훅 사용 시)
# REVENUECAT_WEBHOOK_SECRET=

# --- Cache ---
CACHE_TYPE=memory
CACHE_DEFAULT_TTL_MS=60000

# --- Push Notifications ---
PUSH_RATE_LIMIT_BACKEND=postgres
# EXPO_ACCESS_TOKEN=
# 신규 가입자만 등록됩니다. 배포 시 false로 두고 검증 후 활성화하세요.
RETENTION_ONBOARDING_V2_ENABLED=false
RETENTION_ONBOARDING_V2_TREATMENT_PERCENT=50

# --- Monitoring ---
# SENTRY_DSN=

# --- App Version Check ---
# 스토어에 실제 공개된 버전만 설정하고, 양 플랫폼 값 확인 후 활성화합니다.
APP_VERSION_CHECK_ENABLED=false
APP_VERSION_CHECK_IOS_LATEST_VERSION=1.10.0
APP_VERSION_CHECK_ANDROID_LATEST_VERSION=1.10.0

# --- 콕 찌르기 답장·감사 (1.11.0, 기본 비활성) ---
NUDGE_INTERACTIONS_ENABLED=false

# --- 친구 초대 링크 (1.13.0, 서버 반영 전 자리표시자) ---
# 초대 링크 기능 활성화 여부
INVITE_ENABLED=true
# 초대 클레임 식별자 HMAC 키 (활성화 시 필수, 32자 이상). 생성: openssl rand -base64 48
# INVITE_CLAIM_HASH_SECRET=
